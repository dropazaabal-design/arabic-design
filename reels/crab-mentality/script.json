{
  "title": "عقلية السلطعون",
  "version": 2,
  "register": "عامية عربية بيضاء",
  "voice": {
    "engine": "Habibi-TTS",
    "checkpoint": "Specialized/MSA/model_200000",
    "licence": "Apache-2.0",
    "reference": "SWivid/Habibi benchmark (Apache-2.0), MSA split, see voice.json",
    "note": "نسخة واحدة ومقطع مرجعي واحد وسرعة وبذرة ثابتة لكل المقاطع."
  },
  "segments": [
    {
      "id": "s1",
      "scene": 1,
      "text": "كل ما تحاول تتقدّم… في أحد يرجّعك خطوة."
    },
    {
      "id": "s2",
      "scene": 2,
      "text": "أحيانًا الطريق مفتوح، لكن بعض اللي حولك يحاولون يوقفونك."
    },
    {
      "id": "s3",
      "scene": 2,
      "text": "ولهذه الصورة اسم: عقلية السلطعون."
    },
    {
      "id": "s4",
      "scene": 3,
      "text": "تخيّل سلطعون يحاول يطلع من سطل… والبقية يسحبونه لتحت."
    },
    {
      "id": "s5",
      "scene": 3,
      "text": "هي مجرد استعارة… لكنها تتكرر بيننا."
    },
    {
      "id": "s6",
      "scene": 4,
      "text": "تقول: راح أتعلّم مهارة."
    },
    {
      "id": "s7",
      "scene": 4,
      "text": "يرد عليك: وحتى اللي تعلّموا، ماذا حققوا؟"
    },
    {
      "id": "s8",
      "scene": 5,
      "text": "تبدأ مشروع صغير."
    },
    {
      "id": "s9",
      "scene": 5,
      "text": "يقول لك: خفّف أحلامك."
    },
    {
      "id": "s10",
      "scene": 6,
      "text": "لكن انتبه: بعض الانتقاد يساعدك."
    },
    {
      "id": "s11",
      "scene": 6,
      "text": "النصيحة توضّح الخطأ، وتعطيك طريقة تصلحه."
    },
    {
      "id": "s12",
      "scene": 6,
      "text": "والتثبيط يوقف المحاولة من البداية."
    },
    {
      "id": "s13",
      "scene": 7,
      "text": "كيف تتعامل معه؟"
    },
    {
      "id": "s14",
      "scene": 7,
      "text": "قلّل مشاركة خططك مع اللي يحبطك."
    },
    {
      "id": "s15",
      "scene": 7,
      "text": "اسأل شخص عنده تجربة."
    },
    {
      "id": "s16",
      "scene": 7,
      "text": "وقِس تقدّمك بما تنجزه."
    },
    {
      "id": "s17",
      "scene": 7,
      "text": "راقب أثر الكلام، ولا تتسرّع في الحكم على النوايا."
    },
    {
      "id": "s18",
      "scene": 8,
      "text": "وإذا تعثّرت، عدّل طريقتك وواصل."
    },
    {
      "id": "s19",
      "scene": 8,
      "text": "خروجك يبدأ بخطوة منك… ما يحتاج موافقة السطل."
    }
  ],
