{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ]
    }
  },
  "include": ["src"]
}
