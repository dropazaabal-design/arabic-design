{"text": "القانون الثالث والعشرون: ركّز قواك. الجهد المشتت يضيع، والمشروع الصغير الذي يتقن منتجًا واحدًا يتفوق غالبًا على من يطارد عشرة. لكن ركّز جهدك لا مخاطرك؛ فالاعتماد على مصدر رزق واحد قد يوقعك. فنوّع دخلك، ووحّد هدفك.", "words": [{"text": "القانون", "type": "word", "start": 0, "end": 0.56}, {"text": "الثالث", "type": "word", "start": 0.64, "end": 1.04}, {"text": "والعشرون:", "type": "word", "start": 1.12, "end": 2.24}, {"text": "ركّز", "type": "word", "start": 2.32, "end": 2.8}, {"text": "قواك.", "type": "word", "start": 2.88, "end": 3.44}, {"text": "الجهد", "type": "word", "start": 3.92, "end": 4.32}, {"text": "المشتت", "type": "word", "start": 4.44, "end": 4.96}, {"text": "يضيع،", "type": "word", "start": 5.04, "end": 5.76}, {"text": "والمشروع", "type": "word", "start": 5.8, "end": 6.32}, {"text": "الصغير", "type": "word", "start": 6.4, "end": 6.8}, {"text": "الذي", "type": "word", "start": 6.84, "end": 7.12}, {"text": "يتقن", "type": "word", "start": 7.24, "end": 7.52}, {"text": "منتجًا", "type": "word", "start": 7.6, "end": 8}, {"text": "واحدًا", "type": "word", "start": 8.08, "end": 8.48}, {"text": "يتفوق", "type": "word", "start": 8.72, "end": 9.36}, {"text": "غالبًا", "type": "word", "start": 9.52, "end": 9.84}, {"text": "على", "type": "word", "start": 9.92, "end": 10.08}, {"text": "من", "type": "word", "start": 10.16, "end": 10.24}, {"text": "يطارد", "type": "word", "start": 10.32, "end": 10.8}, {"text": "عشرة.", "type": "word", "start": 10.88, "end": 11.6}, {"text": "لكن", "type": "word", "start": 11.76, "end": 12.08}, {"text": "ركّز", "type": "word", "start": 12.24, "end": 12.64}, {"text": "جهدك", "type": "word", "start": 12.76, "end": 13.12}, {"text": "لا", "type": "word", "start": 13.36, "end": 13.52}, {"text": "مخاطرك؛", "type": "word", "start": 13.72, "end": 14.32}, {"text": "فالاعتماد", "type": "word", "start": 14.48, "end": 15.12}, {"text": "على", "type": "word", "start": 15.24, "end": 15.36}, {"text": "مصدر", "type": "word", "start": 15.4, "en