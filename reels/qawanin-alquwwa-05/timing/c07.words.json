{"text": "القانون السادس والعشرون: أبقِ يديك نظيفتين. وتنبيه خاص: يقصد غرين أن تُحمّل غيرك أخطاءك، وأن تستعمل الآخرين في الأعمال القذرة، وهذا ظلم صريح. القائد الحقيقي يعترف بخطئه، ويحمي فريقه، ومن يرمي أخطاءه على غيره يخسر ثقة الجميع.", "words": [{"text": "القانون", "type": "word", "start": 0, "end": 0.56}, {"text": "السادس", "type": "word", "start": 0.64, "end": 1.12}, {"text": "والعشرون:", "type": "word", "start": 1.2, "end": 2.24}, {"text": "أبقِ", "type": "word", "start": 2.28, "end": 2.64}, {"text": "يديك", "type": "word", "start": 2.72, "end": 3.2}, {"text": "نظيفتين.", "type": "word", "start": 3.32, "end": 4.08}, {"text": "وتنبيه", "type": "word", "start": 4.56, "end": 5.12}, {"text": "خاص:", "type": "word", "start": 5.2, "end": 6}, {"text": "يقصد", "type": "word", "start": 6.12, "end": 6.4}, {"text": "غرين", "type": "word", "start": 6.48, "end": 6.8}, {"text": "أن", "type": "word", "start": 6.88, "end": 7.04}, {"text": "تُحمّل", "type": "word", "start": 7.08, "end": 7.52}, {"text": "غيرك", "type": "word", "start": 7.6, "end": 8}, {"text": "أخطاءك،", "type": "word", "start": 8.04, "end": 8.88}, {"text": "وأن", "type": "word", "start": 8.92, "end": 9.12}, {"text": "تستعمل", "type": "word", "start": 9.2, "end": 9.68}, {"text": "الآخرين", "type": "word", "start": 9.72, "end": 10.24}, {"text": "في", "type": "word", "start": 10.32, "end": 10.4}, {"text": "الأعمال", "type": "word", "start": 10.48, "end": 10.8}, {"text": "القذرة،", "type": "word", "start": 10.88, "end": 11.68}, {"text": "وهذا", "type": "word", "start": 11.76, "end": 12.32}, {"text": "ظلم", "type": "word", "start": 12.4, "end": 12.8}, {"text": "صريح.", "type": "word", "start": 12.88, "end": 13.36}, {"text": "القائد", "type": "word", "start": 13.76, "end": 14.24}, {"text": "الحقيقي", "type": "word", "start": 14.32, "end": 14.96}, {"text": "يعترف", "type": "word", "start": 15.04, "end": 15.6}, {"text": "بخطئه،", "type": "word", "start": 15.68, "end": 16.4}, {"text": "ويحمي", "type": "word", "start": 16