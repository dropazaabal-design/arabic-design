{"text": "القانون الثاني والعشرون: استعمل تكتيك الاستسلام، وحوّل الضعف إلى قوة. فيه حكمة: إذا كنت أضعف، فالتراجع المؤقت يحفظ ما بقي لك بدل خسارة كل شيء. لكن غرين يجعله أحيانًا ستارًا لانتقام لاحق، وهذا غدر. تراجع بصدق، وابنِ نفسك من جديد.", "words": [{"text": "القانون", "type": "word", "start": 0, "end": 0.48}, {"text": "الثاني", "type": "word", "start": 0.56, "end": 0.96}, {"text": "والعشرون:", "type": "word", "start": 1.08, "end": 2.08}, {"text": "استعمل", "type": "word", "start": 2.24, "end": 2.64}, {"text": "تكتيك", "type": "word", "start": 2.72, "end": 3.12}, {"text": "الاستسلام،", "type": "word", "start": 3.2, "end": 4.16}, {"text": "وحوّل", "type": "word", "start": 4.24, "end": 4.72}, {"text": "الضعف", "type": "word", "start": 4.8, "end": 5.28}, {"text": "إلى", "type": "word", "start": 5.36, "end": 5.52}, {"text": "قوة.", "type": "word", "start": 5.68, "end": 6.48}, {"text": "فيه", "type": "word", "start": 6.56, "end": 6.8}, {"text": "حكمة:", "type": "word", "start": 6.92, "end": 7.6}, {"text": "إذا", "type": "word", "start": 7.64, "end": 7.84}, {"text": "كنت", "type": "word", "start": 7.92, "end": 8.16}, {"text": "أضعف،", "type": "word", "start": 8.24, "end": 8.88}, {"text": "فالتراجع", "type": "word", "start": 8.92, "end": 9.44}, {"text": "المؤقت", "type": "word", "start": 9.56, "end": 10.08}, {"text": "يحفظ", "type": "word", "start": 10.16, "end": 10.56}, {"text": "ما", "type": "word", "start": 10.64, "end": 10.8}, {"text": "بقي", "type": "word", "start": 10.88, "end": 11.12}, {"text": "لك", "type": "word", "start": 11.2, "end": 11.44}, {"text": "بدل", "type": "word", "start": 11.6, "end": 11.84}, {"text": "خسارة", "type": "word", "start": 11.92, "end": 12.4}, {"text": "كل", "type": "word", "start": 12.56, "end": 12.72}, {"text": "شيء.", "type": "word", "start": 12.8, "end": 13.44}, {"text": "لكن", "type": "word", "start": 13.52, "end": 13.84}, {"text": "غرين", "type": "word", "start": 13.92, "end": 14.24}, {"text": "يجعله", "type": "word", "start": 14.36,