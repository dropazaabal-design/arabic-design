[
 {
  "seg": "s01",
  "text": "لا ترسلها وأنت غاضب.",
  "start": 0.216,
  "end": 2.549,
  "chars": 20,
  "cps": 8.6
 },
 {
  "seg": "s02",
  "text": "وصلتك رسالة ضايقتك.",
  "start": 2.549,
  "end": 4.718,
  "chars": 19,
  "cps": 8.8
 },
 {
  "seg": "s02",
  "text": "فتحت المحادثة، وكتبت ردًّا قاسيًا…",
  "start": 4.718,
  "end": 7.932,
  "chars": 34,
  "cps": 10.6
 },
 {
  "seg": "s02",
  "text": "وبقيت ضغطة واحدة.",
  "start": 7.932,
  "end": 9.954,
  "chars": 17,
  "cps": 8.4
 },
 {
  "seg": "s03",
  "text": "هنا اسأل نفسك:",
  "start": 9.954,
  "end": 11.581,
  "chars": 14,
  "cps": 8.6
 },
 {
  "seg": "s03",
  "text": "هذا الردّ يخدمك، أم يفرّغ غضبك فقط؟",
  "start": 11.581,
  "end": 15.309,
  "chars": 35,
  "cps": 9.4
 },
 {
  "seg": "s04",
  "text": "في كتاب «التفكير الواضح»،",
  "start": 15.309,
  "end": 17.224,
  "chars": 25,
  "cps": 13.1
 },
 {
  "seg": "s04",
  "text": "يشرح شين باريش كيف قد نقع في ردود فعل تلقائية،",
  "start": 17.224,
  "end": 20.916,
  "chars": 46,
  "cps": 12.5
 },
 {
  "seg": "s04",
  "text": "قبل أن ننتبه أن أمامنا قرارًا.",
  "start": 20.916,
  "end": 23.878,
  "chars": 30,
  "cps": 10.1
 },
 {
  "seg": "s05",
  "text": "جرّب تصنع وقفة:",
  "start": 23.878,
  "end": 25.524,
  "chars": 15,
  "cps": 9.1
 },
 {
  "seg": "s05",
  "text": "اترك الردّ في المسودات، وابتعد قليلًا.",
  "start": 25.524,
  "end": 28.997,
  "chars": 38,
  "cps": 10.9
 },
 {
  "seg": "s05",
  "text": "ارجع له عندما تهدأ.",
  "start": 29.27,
  "end": 31.224,
  "chars": 19,
  "cps": 9.7
 },
 {
  "seg": "s06",
  "text": "هل ما زلت تريد إرساله؟",
  "start": 31.224,
  "end": 33.12,
  "chars": 22,
  "cps": 11.6
 },
 {
  "seg": "s06",
  "text": "هل يمكنك قول الشيء نفسه دون إهانة؟",
  "start": 33.12,
  "end": 36.229,
  "chars": 34,
  "cps": 10.9
 },
 {
  "seg": "s07",
  "text": "الوقفة لا تلغي حقك في الردّ.",
  "start": 36.229,
  "end": 38.79,
  "chars": 28,
  "cps": 10.9
 },
 {
  "seg": "s07",
  "text": "تعطيك فرصة تختار كيف تردّ.",
  "start": 38.79,
  "end": 41.849,
  "chars": 26,
  "cps": 8.5
 },
 {
  "seg": "s08",
  "text": "اكتب لنفسك قاعدة: «سأردّ عندما أهدأ».",
  "start": 41.955,
  "end": 45.781,
  "chars": 37,
  "cps": 9.7
 },
 {
  "seg": "s09",
  "text": "احفظها للرسالة القادمة.",
  "start": 45.781,
  "end": 48.076,
  "chars": 23,
  "cps": 10.0
 }
]
