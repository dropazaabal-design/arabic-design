{
 "source": "provisional (11.8 chars/s, EP05 rate of this voice)",
 "total": 83.059,
 "frames": 4984,
 "lines": [
  {
   "id": 1,
   "unit": "A",
   "text": "خدمة عملاء آراء الناس… معك نايف، تفضّل؟",
   "start": 0.4,
   "end": 4.09
  },
  {
   "id": 2,
   "unit": "A",
   "text": "نايف عنده وظيفة ثانية… ما قدّم عليها.",
   "start": 4.74,
   "end": 8.141
  },
  {
   "id": 3,
   "unit": "A",
   "text": "بلا راتب، بلا إجازة… ولا أحد قال له متى يرضون.",
   "start": 8.491,
   "end": 12.775
  },
  {
   "id": 4,
   "unit": "A",
   "text": "وشغله الحقيقي؟ أول عميل… والتسليم الساعة خمس.",
   "start": 13.125,
   "end": 17.204
  },
  {
   "id": 5,
   "unit": "A",
   "text": "أول شكوى… بسيطة.",
   "start": 17.754,
   "end": 19.375
  },
  {
   "id": 6,
   "unit": "A",
   "text": "كتب اعتذار. مسحه. حط هههه… شالها… رجّعها.",
   "start": 20.525,
   "end": 24.53
  },
  {
   "id": 7,
   "unit": "A",
   "text": "وبعد خمس وأربعين دقيقة… أرسل: أبشر.",
   "start": 25.08,
   "end": 28.461
  },
  {
   "id": 8,
   "unit": "B",
   "text": "الشكوى الثانية… عكس الأولى بالضبط.",
   "start": 30.011,
   "end": 33.158
  },
  {
   "id": 9,
   "unit": "B",
   "text": "فطلع بحل إداري… واعتمده رسمي.",
   "start": 34.108,
   "end": 36.831
  },
  {
   "id": 10,
   "unit": "B",
   "text": "لا قبل… ولا بعد.",
   "start": 37.181,
   "end": 38.802
  },
  {
   "id": 11,
   "unit": "B",
   "text": "وبعدها… فتحوا عليه قسم المقارنات.",
   "start": 40.352,
   "end": 43.414
  },
  {
   "id": 12,
   "unit": "B",
   "text": "وترقّى أخيرًا… صار مسؤول عن زعل ناس ما يعرفهم.",
   "start": 43.764,
   "end": 47.928
  },
  {
   "id": 13,
   "unit": "C",
   "text": "وفي وسط الزحمة… وصلته رسالة من العميل الوحيد اللي يدفع.",
   "start": 49.078,
   "end": 54.004
  },
  {
   "id": 14,
   "unit": "C",
   "text": "خدم الكل اليوم… إلا الشي الوحيد اللي اختاره بنفسه.",
   "start": 55.854,
   "end": 60.357
  },
  {
   "id": 15,
   "unit": "D",
   "text": "الصبح… وصلته ورقتين.",
   "start": 61.507,
   "end": 63.467
  },
  {
   "id": 16,
   "unit": "D",
   "text": "ملاحظة تفيد شغله… هذي تستاهل.",
   "start": 64.717,
   "end": 67.44
  },
  {
   "id": 17,
   "unit": "D",
   "text": "وهالمرة، أبشر… أخذت ثانيتين.",
   "start": 67.79,
   "end": 70.548
  },
  {
   "id": 18,
   "unit": "D",
   "text": "ومقارنة ما تفيد أحد… تنقرأ، وتنحفظ.",
   "start": 72.898,
   "end": 76.249
  },
  {
   "id": 19,
   "unit": "D",
   "text": "وأنت… شغّال عند مين؟",
   "start": 78.099,
   "end": 80.059
  }
 ]
}
