{
 "source": "recording",
 "total": 77.14,
 "frames": 4628,
 "lines": [
  {
   "id": 1,
   "unit": "A",
   "text": "خدمة عملاء آراء الناس… معك نايف، تفضّل؟",
   "start": 0.4,
   "end": 3.98
  },
  {
   "id": 2,
   "unit": "A",
   "text": "نايف عنده وظيفة ثانية… ما قدّم عليها.",
   "start": 4.4,
   "end": 7.425
  },
  {
   "id": 3,
   "unit": "A",
   "text": "بلا راتب، بلا إجازة… ولا أحد قال له متى يرضون.",
   "start": 7.545,
   "end": 11.635
  },
  {
   "id": 4,
   "unit": "A",
   "text": "وشغله الحقيقي؟ أول عميل… والتسليم الساعة خمس.",
   "start": 11.755,
   "end": 15.58
  },
  {
   "id": 5,
   "unit": "A",
   "text": "أول شكوى… بسيطة.",
   "start": 15.9,
   "end": 17.655
  },
  {
   "id": 6,
   "unit": "A",
   "text": "كتب اعتذار. مسحه. حط هههه… شالها… رجّعها.",
   "start": 18.375,
   "end": 22.92
  },
  {
   "id": 7,
   "unit": "A",
   "text": "وبعد خمس وأربعين دقيقة… أرسل: أبشر.",
   "start": 23.24,
   "end": 26.41
  },
  {
   "id": 8,
   "unit": "B",
   "text": "الشكوى الثانية… عكس الأولى بالضبط.",
   "start": 27.53,
   "end": 30.405
  },
  {
   "id": 9,
   "unit": "B",
   "text": "فطلع بحل إداري… واعتمده رسمي.",
   "start": 31.125,
   "end": 33.795
  },
  {
   "id": 10,
   "unit": "B",
   "text": "لا قبل… ولا بعد.",
   "start": 33.915,
   "end": 35.645
  },
  {
   "id": 11,
   "unit": "B",
   "text": "وبعدها… فتحوا عليه قسم المقارنات.",
   "start": 36.765,
   "end": 40.01
  },
  {
   "id": 12,
   "unit": "B",
   "text": "وترقّى أخيرًا… صار مسؤول عن زعل ناس ما يعرفهم.",
   "start": 40.13,
   "end": 44.02
  },
  {
   "id": 13,
   "unit": "C",
   "text": "وفي وسط الزحمة… وصلته رسالة من العميل الوحيد اللي يدفع.",
   "start": 44.74,
   "end": 49.41
  },
  {
   "id": 14,
   "unit": "C",
   "text": "خدم الكل اليوم… إلا الشي الوحيد اللي اختاره بنفسه.",
   "start": 50.83,
   "end": 54.61
  },
  {
   "id": 15,
   "unit": "D",
   "text": "الصبح… وصلته ورقتين.",
   "start": 55.53,
   "end": 57.945
  },
  {
   "id": 16,
   "unit": "D",
   "text": "ملاحظة تفيد شغله… هذي تستاهل.",
   "start": 58.765,
   "end": 61.845
  },
  {
   "id": 17,
   "unit": "D",
   "text": "وهالمرة، أبشر… أخذت ثانيتين.",
   "start": 61.965,
   "end": 64.89
  },
  {
   "id": 18,
   "unit": "D",
   "text": "ومقارنة ما تفيد أحد… تنقرأ، وتنحفظ.",
   "start": 66.81,
   "end": 70.44
  },
  {
   "id": 19,
   "unit": "D",
   "text": "وأنت… شغّال عند مين؟",
   "start": 72.36,
   "end": 74.34
  }
 ]
}
