[
  {
    "text": "سماعاتٌ بأربعين دولارًا…",
    "seg": "s01",
    "start": 0.5,
    "end": 2.76
  },
  {
    "text": "قد تبدو لك غالية",
    "seg": "s01",
    "start": 2.76,
    "end": 3.914
  },
  {
    "text": "ثم تظهر بجانبها سماعاتٌ بمئتي دولار",
    "seg": "s02",
    "start": 4.247,
    "end": 7.525
  },
  {
    "text": "وفجأة… تبدو الأولى أخفّ",
    "seg": "s03",
    "start": 7.766,
    "end": 10.12
  },
  {
    "text": "مع أن سعرها لم يتغيّر",
    "seg": "s03",
    "start": 10.12,
    "end": 12.06
  },
  {
    "text": "والسماعات هي نفسها",
    "seg": "s03",
    "start": 12.06,
    "end": 13.548
  },
  {
    "text": "ما الذي تغيّر إذن؟",
    "seg": "s04",
    "start": 14.9,
    "end": 16.82
  },
  {
    "text": "ليس السماعات…",
    "seg": "s04",
    "start": 16.82,
    "end": 17.82
  },
  {
    "text": "بل ما وُضع بجانبها",
    "seg": "s04",
    "start": 17.82,
    "end": 19.401
  },
  {
    "text": "وهذا يحدث معنا أكثر مما نظن",
    "seg": "s05",
    "start": 19.768,
    "end": 22.4
  },
  {
    "text": "في متجر في عرضِ اشتراك",
    "seg": "s05",
    "start": 22.4,
    "end": 24.4
  },
  {
    "text": "أو حين نقول «نعم» لشيءٍ لم نكن مقتنعين به تمامًا",
    "seg": "s05",
    "start": 24.4,
    "end": 28.399
  },
  {
    "text": "ثم نسأل أنفسنا لاحقًا",
    "seg": "s06",
    "start": 28.76,
    "end": 30.78
  },
  {
    "text": "لماذا وافقتُ أصلًا؟",
    "seg": "s06",
    "start": 30.78,
    "end": 32.186
  },
  {
    "text": "في كتاب «التأثير",
    "seg": "s07",
    "start": 33.8,
    "end": 35.26
  },
  {
    "text": "علم نفس الإقناع»",
    "seg": "s07",
    "start": 35.26,
    "end": 36.56
  },
  {
    "text": "يشرح روبرت سيالديني",
    "seg": "s07",
    "start": 36.56,
    "end": 38.2
  },
  {
    "text": "أستاذ علم النفس",
    "seg": "s07",
    "start": 38.2,
    "end": 39.32
  },
  {
    "text": "كيف نعتمد على اختصاراتٍ ذهنية لنقرّر بسرعة",
    "seg": "s07",
    "start": 39.32,
    "end": 42.966
  },
  {
    "text": "هذه الاختصارات توفّر علينا الوقت والجهد",
    "seg": "s08",
    "start": 43.309,
    "end": 46.42
  },
  {
    "text": "وغالبًا ما تخدمنا جيدًا",
    "seg": "s08",
    "start": 46.42,
    "end": 48.242
  },
  {
    "text": "لكنها قد تُستغَل…",
    "seg": "s09",
    "start": 48.58,
    "end": 50.22
  },
  {
    "text": "حين يرتّب أحدٌ ما نراه",
    "seg": "s09",
    "start": 50.22,
    "end": 52.3
  },
  {
    "text": "قبل أن نقرّر",
    "seg": "s09",
    "start": 52.3,
    "end": 53.344
  },
  {
    "text": "وفكرة اليوم واحدة منها",
    "seg": "s10",
    "start": 53.7,
    "end": 55.78
  },
  {
    "text": "يسمّيها سيالديني",
    "seg": "s10",
    "start": 55.78,
    "end": 57.26
  },
  {
    "text": "مبدأ التباين",
    "seg": "s10",
    "start": 57.26,
    "end": 58.385
  },
  {
    "text": "عقلك لا يقيس الأشياء بمسطرةٍ ثابتة…",
    "seg": "s11",
    "start": 60.268,
    "end": 63.38
  },
  {
    "text": "بل يقارنها بما رآه قبلها مباشرة",
    "seg": "s11",
    "start": 63.38,
    "end": 66.12
  },
  {
    "text": "جرّب هذا ثلاثة أوعية ماء؛ واحد بارد",
    "seg": "s12",
    "start": 66.478,
    "end": 70.26
  },
  {
    "text": "وواحد ساخن",
    "seg": "s12",
    "start": 70.26,
    "end": 71.48
  },
  {
    "text": "وبينهما وعاءٌ فاتر",
    "seg": "s12",
    "start": 71.48,
    "end": 73.15
  },
  {
    "text": "ضع يدًا في البارد والأخرى في الساخن",
    "seg": "s13",
    "start": 73.42,
    "end": 76.04
  },
  {
    "text": "ثم انقل اليدين معًا إلى الفاتر",
    "seg": "s13",
    "start": 76.04,
    "end": 78.46
  },
  {
    "text": "اليد القادمة من البارد تشعر بالدفء",
    "seg": "s13",
    "start": 78.46,
    "end": 81.3
  },
  {
    "text": "والقادمة من الساخن تشعر بالبرودة",
    "seg": "s13",
    "start": 81.3,
    "end": 83.888
  },
  {
    "text": "الماء واحد…",
    "seg": "s14",
    "start": 84.36,
    "end": 85.38
  },
  {
    "text": "والإحساس مختلف",
    "seg": "s14",
    "start": 85.38,
    "end": 86.796
  },
  {
    "text": "وهنا لبّ الفكرة",
    "seg": "s15",
    "start": 87.144,
    "end": 88.64
  },
  {
    "text": "الترتيب ليس تفصيلًا",
    "seg": "s15",
    "start": 88.64,
    "end": 90.94
  },
  {
    "text": "ما تراه أولًا يصبح نقطةَ المقارنة",
    "seg": "s15",
    "start": 90.94,
    "end": 93.72
  },
  {
    "text": "وما بعده يُقاس عليها",
    "seg": "s15",
    "start": 93.72,
    "end": 95.497
  },
  {
    "text": "وهذا مفيد في حياتنا؛ فالمقارنة تساعدنا على الفهم",
    "seg": "s16",
    "start": 95.76,
    "end": 99.741
  },
  {
    "text": "لكن لنرَ كيف يتطوّر القرار في مثال افتراضي",
    "seg": "s17",
    "start": 101.024,
    "end": 104.57
  },
  {
    "text": "لو رأيت السماعات بأربعين دولارًا وحدها",
    "seg": "s18",
    "start": 104.92,
    "end": 107.8
  },
  {
    "text": "ستقارنها غالبًا بما في جيبك",
    "seg": "s18",
    "start": 107.8,
    "end": 110.14
  },
  {
    "text": "وبما تحتاجه فعلًا",
    "seg": "s18",
    "start": 110.14,
    "end": 111.631
  },
  {
    "text": "لكن حين تراها بجانب سماعاتٍ بمئتي دولار",
    "seg": "s19",
    "start": 112.06,
    "end": 115.4
  },
  {
    "text": "تتغيّر نقطة المقارنة…",
    "seg": "s19",
    "start": 115.4,
    "end": 117.32
  },
  {
    "text": "فتبدو الأربعون صفقة",
    "seg": "s19",
    "start": 117.32,
    "end": 118.776
  },
  {
    "text": "السعر ثابت",
    "seg": "s20",
    "start": 119.041,
    "end": 120.18
  },
  {
    "text": "لكن الإحساس به تحرّك",
    "seg": "s20",
    "start": 120.18,
    "end": 122.139
  },
  {
    "text": "تخيّل أنك قرّرت ألّا تدفع أكثر من ثلاثين دولارًا",
    "seg": "s21",
    "start": 122.468,
    "end": 126.56
  },
  {
    "text": "يعرض عليك البائع أولًا سماعاتٍ بمئتين",
    "seg": "s21",
    "start": 126.56,
    "end": 129.64
  },
  {
    "text": "ثم يقول «وعندي هذه بأربعين»",
    "seg": "s21",
    "start": 129.64,
    "end": 132.251
  },
  {
    "text": "فتشتريها وأنت تشعر أنك وفّرت مئة وستين دولارًا…",
    "seg": "s22",
    "start": 132.543,
    "end": 136.84
  },
  {
    "text": "مع أنك دفعت عشرة دولارات فوق خطتك",
    "seg": "s22",
    "start": 136.84,
    "end": 139.895
  },
  {
    "text": "لم يكذب عليك أحد؛ فقط تغيّر ترتيب العرض",
    "seg": "s23",
    "start": 140.161,
    "end": 143.74
  },
  {
    "text": "فبدأتَ المقارنة من الأغلى",
    "seg": "s23",
    "start": 143.74,
    "end": 145.845
  },
  {
    "text": "لذلك انتبه أن يبدو الشيء أخفّ بالمقارنة…",
    "seg": "s24",
    "start": 146.142,
    "end": 149.9
  },
  {
    "text": "لا يعني أنه مناسبٌ لك",
    "seg": "s24",
    "start": 149.9,
    "end": 151.671
  },
  {
    "text": "والآلية نفسها تعمل في مواقف أخرى",
    "seg": "s25",
    "start": 153.0,
    "end": 155.92
  },
  {
    "text": "تشتري حاسوبًا بتسعمئة دولار",
    "seg": "s25",
    "start": 155.92,
    "end": 158.22
  },
  {
    "text": "فيُعرض عليك غطاءٌ له بستين دولارًا",
    "seg": "s25",
    "start": 158.22,
    "end": 161.1
  },
  {
    "text": "بجانب التسعمئة",
    "seg": "s26",
    "start": 161.48,
    "end": 162.7
  },
  {
    "text": "تبدو الستون صغيرة",
    "seg": "s26",
    "start": 162.7,
    "end": 164.003
  },
  {
    "text": "لكن هل كنت ستدفع ستين دولارًا في غطاء",
    "seg": "s27",
    "start": 164.26,
    "end": 167.6
  },
  {
    "text": "لو عُرض عليك وحده في يومٍ عادي؟",
    "seg": "s27",
    "start": 167.6,
    "end": 169.914
  },
  {
    "text": "وهنا تصحيحٌ مهم",
    "seg": "s28",
    "start": 170.42,
    "end": 171.98
  },
  {
    "text": "هذا لا يعني أنك ساذج",
    "seg": "s28",
    "start": 171.98,
    "end": 174.0
  },
  {
    "text": "ولا أن كل عرضٍ خدعة",
    "seg": "s28",
    "start": 174.0,
    "end": 175.587
  },
  {
    "text": "يعني فقط أننا لا نحكم على الأشياء في فراغ",
    "seg": "s29",
    "start": 175.848,
    "end": 179.14
  },
  {
    "text": "فإذا لم نختر نقطة المقارنة بأنفسنا…",
    "seg": "s29",
    "start": 179.14,
    "end": 182.02
  },
  {
    "text": "قد نتركها لغيرنا يختارها لنا",
    "seg": "s29",
    "start": 182.02,
    "end": 184.439
  },
  {
    "text": "فكيف تحمي قرارك؟",
    "seg": "s30",
    "start": 185.819,
    "end": 187.64
  },
  {
    "text": "جرّب ثلاث خطوات بسيطة",
    "seg": "s30",
    "start": 187.64,
    "end": 189.529
  },
  {
    "text": "أولًا الحاجة",
    "seg": "s31",
    "start": 189.94,
    "end": 191.6
  },
  {
    "text": "قبل أن ترى الخيارات",
    "seg": "s31",
    "start": 191.6,
    "end": 192.98
  },
  {
    "text": "اسأل ما الذي أحتاجه فعلًا؟",
    "seg": "s31",
    "start": 192.98,
    "end": 195.266
  },
  {
    "text": "ثانيًا معيار مستقل",
    "seg": "s32",
    "start": 195.82,
    "end": 197.88
  },
  {
    "text": "ضع رقمًا أو معيارًا من حياتك",
    "seg": "s32",
    "start": 197.88,
    "end": 200.2
  },
  {
    "text": "ميزانيتك أو كم ساعةً ستستخدمه في الشهر",
    "seg": "s32",
    "start": 200.2,
    "end": 203.435
  },
  {
    "text": "ثالثًا القرار",
    "seg": "s33",
    "start": 203.86,
    "end": 205.58
  },
  {
    "text": "احكم على الخيار وحده",
    "seg": "s33",
    "start": 205.58,
    "end": 207.38
  },
  {
    "text": "واسأل لو لم أرَ الأغلى…",
    "seg": "s33",
    "start": 207.38,
    "end": 209.3
  },
  {
    "text": "هل كنت سأشتريه؟",
    "seg": "s33",
    "start": 209.3,
    "end": 210.552
  },
  {
    "text": "وهذه تجربة صغيرة لهذا الأسبوع",
    "seg": "s34",
    "start": 211.1,
    "end": 213.88
  },
  {
    "text": "قبل أي شراءٍ فوق عشرين دولارًا",
    "seg": "s34",
    "start": 213.88,
    "end": 216.5
  },
  {
    "text": "اكتب حاجتك وميزانيتك قبل أن تنظر إلى العروض",
    "seg": "s34",
    "start": 216.5,
    "end": 219.921
  },
  {
    "text": "السماعات في البداية لم تتغيّر…",
    "seg": "s35",
    "start": 221.24,
    "end": 223.72
  },
  {
    "text": "والسعر لم يتغيّر",
    "seg": "s35",
    "start": 223.72,
    "end": 225.331
  },
  {
    "text": "فقبل أن تقول «نعم» في المرة القادمة",
    "seg": "s36",
    "start": 225.551,
    "end": 228.78
  },
  {
    "text": "توقّف لحظة واسأل",
    "seg": "s36",
    "start": 228.78,
    "end": 230.409
  },
  {
    "text": "هل وافقتُ لأن الشيء يناسبني…",
    "seg": "s37",
    "start": 230.792,
    "end": 233.14
  },
  {
    "text": "أم لأن طريقة عرضه جعلته يبدو كذلك؟",
    "seg": "s37",
    "start": 233.14,
    "end": 236.32
  }
]
