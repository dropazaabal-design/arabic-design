[
  {
    "text": "تبي تقرب من الناس…",
    "seg": "s1",
    "start": 0.0,
    "end": 1.78
  },
  {
    "text": "بس كل ما قرّبت",
    "seg": "s1",
    "start": 1.78,
    "end": 3.24
  },
  {
    "text": "انجرحت؟",
    "seg": "s1",
    "start": 3.24,
    "end": 4.38
  },
  {
    "text": "هذي اسمها معضلة القنفذ",
    "seg": "s2",
    "start": 4.38,
    "end": 6.4
  },
  {
    "text": "حكاية فلسفية ذكرها شوبنهاور",
    "seg": "s2",
    "start": 6.4,
    "end": 8.94
  },
  {
    "text": "في ليلة باردة قنافذ قرّبت من بعض عشان تدفى",
    "seg": "s3",
    "start": 8.94,
    "end": 12.46
  },
  {
    "text": "بس كل ما التصقت…",
    "seg": "s4",
    "start": 12.46,
    "end": 13.9
  },
  {
    "text": "الأشواك وخزت بعضها",
    "seg": "s4",
    "start": 13.9,
    "end": 15.96
  },
  {
    "text": "فابتعدت…",
    "seg": "s5",
    "start": 15.96,
    "end": 17.06
  },
  {
    "text": "ورجع البرد",
    "seg": "s5",
    "start": 17.06,
    "end": 18.18
  },
  {
    "text": "وظلّت تقرّب وتبعد",
    "seg": "s6",
    "start": 18.18,
    "end": 19.84
  },
  {
    "text": "لين لقت مسافة",
    "seg": "s6",
    "start": 19.84,
    "end": 21.36
  },
  {
    "text": "دافية وما توخز",
    "seg": "s6",
    "start": 21.36,
    "end": 23.14
  },
  {
    "text": "وإحنا كذا",
    "seg": "s7",
    "start": 23.14,
    "end": 24.2
  },
  {
    "text": "القرب يدفّي",
    "seg": "s7",
    "start": 24.2,
    "end": 25.32
  },
  {
    "text": "والقرب الزايد يوخز",
    "seg": "s7",
    "start": 25.32,
    "end": 27.12
  },
  {
    "text": "مثلًا تحب أخوك",
    "seg": "s8",
    "start": 27.12,
    "end": 28.94
  },
  {
    "text": "بس ما تحب يفتح جوالك",
    "seg": "s8",
    "start": 28.94,
    "end": 30.62
  },
  {
    "text": "هذي مو قطيعة",
    "seg": "s9",
    "start": 30.62,
    "end": 31.96
  },
  {
    "text": "هذي مساحتك",
    "seg": "s9",
    "start": 31.96,
    "end": 33.12
  },
  {
    "text": "والزيارة؟ خلّها مستمرة…",
    "seg": "s10",
    "start": 33.12,
    "end": 35.1
  },
  {
    "text": "بس بموعد يريّح البيتين",
    "seg": "s10",
    "start": 35.1,
    "end": 37.04
  },
  {
    "text": "الحد اللطيف ما يقطع الود…",
    "seg": "s11",
    "start": 37.04,
    "end": 38.94
  },
  {
    "text": "يحميه",
    "seg": "s11",
    "start": 38.94,
    "end": 39.84
  },
  {
    "text": "احفظ الفيديو",
    "seg": "s12",
    "start": 39.84,
    "end": 40.94
  },
  {
    "text": "وارجع له لما تحتاج مسافة دافية",
    "seg": "s12",
    "start": 40.94,
    "end": 43.08
  }
]
