{"text": "القانون الخامس: السمعة تعني الكثير، فاحرسها. السمعة تسبقك، وتصنعها الأفعال المتكررة. لكن غرين يقترح أيضًا هدم سمعة المنافس، وهذا غيبة أو بهتان لا نقبله. احمِ سمعتك بعملك، لا بتشويه غيرك.", "words": [{"text": "القانون", "type": "word", "start": 0, "end": 0}, {"text": "الخامس:", "type": "word", "start": 0.12, "end": 0.48}, {"text": "السمعة", "type": "word", "start": 0.56, "end": 1.68}, {"text": "تعني", "type": "word", "start": 1.76, "end": 2.16}, {"text": "الكثير،", "type": "word", "start": 2.28, "end": 2.8}, {"text": "فاحرسها.", "type": "word", "start": 2.933, "end": 3.88}, {"text": "السمعة", "type": "word", "start": 4, "end": 4.8}, {"text": "تسبقك،", "type": "word", "start": 4.88, "end": 6.08}, {"text": "وتصنعها", "type": "word", "start": 6.16, "end": 6.8}, {"text": "الأفعال", "type": "word", "start": 6.88, "end": 7.36}, {"text": "المتكررة.", "type": "word", "start": 7.48, "end": 8.24}, {"text": "لكن", "type": "word", "start": 8.64, "end": 8.96}, {"text": "غرين", "type": "word", "start": 9.04, "end": 9.36}, {"text": "يقترح", "type": "word", "start": 9.48, "end": 9.92}, {"text": "أيضًا", "type": "word", "start": 9.96, "end": 10.32}, {"text": "هدم", "type": "word", "start": 10.48, "end": 10.88}, {"text": "سمعة", "type": "word", "start": 11, "end": 11.28}, {"text": "المنافس،", "type": "word", "start": 11.32, "end": 12.08}, {"text": "وهذا", "type": "word", "start": 12.16, "end": 12.56}, {"text": "غيبة", "type": "word", "start": 12.64, "end": 13.2}, {"text": "أو", "type": "word", "start": 13.28, "end": 13.36}, {"text": "بهتان", "type": "word", "start": 13.44, "end": 14}, {"text": "لا", "type": "word", "start": 14.08, "end": 14.24}, {"text": "نقبله.", "type": "word", "start": 14.32, "end": 15.04}, {"text": "احمِ", "type": "word", "start": 15.12, "end": 15.36}, {"text": "سمعتك", "type": "word", "start": 15.44, "end": 16}, {"text": "بعملك،", "type": "word", "start": 16.08, "end": 16.96}, {"text": "لا", "type": "word", "start": 17.04, "end": 17.12}, {"text": "بتشوي