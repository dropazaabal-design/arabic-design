{"text": "القانون الثامن عشر: لا تبنِ حصونًا تعزلك؛ فالعزلة خطرة. وهنا نتفق مع غرين: من ينعزل تفوته الأخبار، ويحيط به من يجامله. وكم من مدير أغلق بابه، فلم يعرف بالمشكلة إلا بعد أن كبرت. خالط الناس، واسمع من ينتقدك، واستشر أهل الخبرة؛ فالشورى قيمة أصيلة في ديننا.", "words": [{"text": "القانون", "type": "word", "start": 0, "end": 0}, {"text": "الثامن", "type": "word", "start": 0.12, "end": 0.496}, {"text": "عشر:", "type": "word", "start": 0.56, "end": 1.12}, {"text": "لا", "type": "word", "start": 1.28, "end": 1.52}, {"text": "تبنِ", "type": "word", "start": 2, "end": 2.24}, {"text": "حصونًا", "type": "word", "start": 2.4, "end": 2.88}, {"text": "تعزلك؛", "type": "word", "start": 2.96, "end": 3.44}, {"text": "فالعزلة", "type": "word", "start": 3.52, "end": 4.48}, {"text": "خطرة.", "type": "word", "start": 4.587, "end": 5.307}, {"text": "وهنا", "type": "word", "start": 5.373, "end": 6.08}, {"text": "نتفق", "type": "word", "start": 6.2, "end": 6.56}, {"text": "مع", "type": "word", "start": 6.68, "end": 6.92}, {"text": "غرين:", "type": "word", "start": 7.04, "end": 7.44}, {"text": "من", "type": "word", "start": 7.52, "end": 7.68}, {"text": "ينعزل", "type": "word", "start": 8.16, "end": 8.52}, {"text": "تفوته", "type": "word", "start": 8.56, "end": 9.12}, {"text": "الأخبار،", "type": "word", "start": 9.2, "end": 9.872}, {"text": "ويحيط", "type": "word", "start": 9.968, "end": 11.04}, {"text": "به", "type": "word", "start": 11.2, "end": 11.36}, {"text": "من", "type": "word", "start": 11.44, "end": 11.6}, {"text": "يجامله.", "type": "word", "start": 11.72, "end": 12.24}, {"text": "وكم", "type": "word", "start": 12.56, "end": 12.88}, {"text": "من", "type": "word", "start": 12.96, "end": 13.04}, {"text": "مدير", "type": "word", "start": 13.28, "end": 13.52}, {"text": "أغلق", "type": "word", "start": 13.68, "end": 14.08}, {"text": "بابه،", "type": "word", "start": 14.16, "end": 14.8}, {"text": "فلم", "type": "word", "start": 14.84, "end": 15.04}, {"text": "يعرف", "type": "wor