[
 {
  "start": 0.3,
  "end": 3.82,
  "text": "كم نصيحة حفظتَ… ولم تستخدم؟"
 },
 {
  "start": 3.92,
  "end": 6.72,
  "text": "فيديو عن القراءة، وآخر عن التركيز"
 },
 {
  "start": 6.72,
  "end": 8.98,
  "text": "وثالث عن ترتيب يومك"
 },
 {
  "start": 8.98,
  "end": 11.52,
  "text": "لكن بعد الحفظ، ماذا تغيّر؟"
 },
 {
  "start": 11.52,
  "end": 13.52,
  "text": "قد تتحول قائمة المحفوظات"
 },
 {
  "start": 13.52,
  "end": 16.06,
  "text": "إلى قائمة أشياء تؤجلها"
 },
 {
  "start": 16.26,
  "end": 19.14,
  "text": "جرّب الآن: اختر نصيحة واحدة"
 },
 {
  "start": 19.14,
  "end": 21.26,
  "text": "وحوّلها إلى فعل صغير"
 },
 {
  "start": 21.54,
  "end": 23.1,
  "text": "نصيحة عن القراءة؟"
 },
 {
  "start": 23.1,
  "end": 25.08,
  "text": "افتح الكتاب واقرأ صفحة"
 },
 {
  "start": 25.08,
  "end": 26.06,
  "text": "عن التركيز؟"
 },
 {
  "start": 26.06,
  "end": 29.22,
  "text": "أبعِد الهاتف وابدأ مهمة واحدة"
 },
 {
  "start": 29.22,
  "end": 31.52,
  "text": "ليس المطلوب تنفيذ كل ما تشاهده"
 },
 {
  "start": 31.52,
  "end": 35.32,
  "text": "المطلوب أن تختار ما يناسبك، وتبدأ"
 },
 {
  "start": 35.52,
  "end": 37.34,
  "text": "قبل أن تحفظ هذا الفيديو…"
 },
 {
  "start": 37.34,
  "end": 39.44,
  "text": "ما الخطوة التي ستنفّذها؟"
 }
]
