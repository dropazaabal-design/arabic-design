[
  {
    "text": "قلت كلمة غلط قدّام مجموعة…",
    "seg": "s1",
    "start": 0.4,
    "end": 2.6
  },
  {
    "text": "ورجعت البيت تعيدها في راسك؟",
    "seg": "s1",
    "start": 2.6,
    "end": 4.399
  },
  {
    "text": "تتذكر مين كان موجود…",
    "seg": "s2",
    "start": 4.648,
    "end": 6.22
  },
  {
    "text": "وتتخيل إنهم لسه يتكلمون عنها",
    "seg": "s2",
    "start": 6.22,
    "end": 8.462
  },
  {
    "text": "وقتها كأن كشاف كبير مسلّط عليك",
    "seg": "s3",
    "start": 9.737,
    "end": 12.717
  },
  {
    "text": "وكل تفصيلة صارت واضحة للكل",
    "seg": "s3",
    "start": 12.717,
    "end": 15.106
  },
  {
    "text": "هذا اسمه تأثير بقعة الضوء",
    "seg": "s4",
    "start": 15.479,
    "end": 18.057
  },
  {
    "text": "إننا أحيانًا نبالغ في تقدير انتباه الآخرين لمظهرنا وتصرفاتنا",
    "seg": "s4",
    "start": 18.057,
    "end": 22.639
  },
  {
    "text": "أنت عشت الموقف من الداخل",
    "seg": "s5",
    "start": 24.068,
    "end": 25.9
  },
  {
    "text": "بكل تفاصيله…",
    "seg": "s5",
    "start": 25.9,
    "end": 27.22
  },
  {
    "text": "فيصعب تشوفه بعيون غيرك",
    "seg": "s5",
    "start": 27.22,
    "end": 29.028
  },
  {
    "text": "في بحث نُشر سنة ألفين",
    "seg": "s6",
    "start": 30.674,
    "end": 32.412
  },
  {
    "text": "لبس مشاركون قمصان عليها صورة لافتة",
    "seg": "s6",
    "start": 32.412,
    "end": 35.752
  },
  {
    "text": "وقدّروا كم واحد لاحظها",
    "seg": "s6",
    "start": 35.752,
    "end": 37.455
  },
  {
    "text": "تقديرهم كان أعلى من عدد اللي لاحظوها فعلًا",
    "seg": "s7",
    "start": 37.7,
    "end": 40.312
  },
  {
    "text": "وفي نقاشات جماعية",
    "seg": "s8",
    "start": 41.248,
    "end": 43.388
  },
  {
    "text": "بالغوا كمان في تقدير بروز كلامهم عند الموجودين",
    "seg": "s8",
    "start": 43.388,
    "end": 46.707
  },
  {
    "text": "أكيد بعض الناس ممكن يلاحظون",
    "seg": "s9",
    "start": 47.238,
    "end": 49.328
  },
  {
    "text": "بس إحساسك بضخامة الموقف…",
    "seg": "s9",
    "start": 49.328,
    "end": 51.448
  },
  {
    "text": "ما يكفي لوحده عشان تعرف حجم انتباههم",
    "seg": "s9",
    "start": 51.448,
    "end": 53.798
  },
  {
    "text": "فلو صار لك موقف مشابه",
    "seg": "s10",
    "start": 55.384,
    "end": 57.112
  },
  {
    "text": "اسأل نفسك",
    "seg": "s10",
    "start": 57.112,
    "end": 58.132
  },
  {
    "text": "إيش اللي لاحظته فعلًا؟",
    "seg": "s10",
    "start": 58.132,
    "end": 59.632
  },
  {
    "text": "وإيش اللي افترضته؟",
    "seg": "s10",
    "start": 59.632,
    "end": 60.793
  },
  {
    "text": "وتخيّل لو شخص ثاني قال نفس الكلمة…",
    "seg": "s11",
    "start": 61.302,
    "end": 63.732
  },
  {
    "text": "كنت بتظل تفكر فيها طول اليوم؟",
    "seg": "s11",
    "start": 63.732,
    "end": 65.668
  },
  {
    "text": "إذا أخطأت بحق أحد",
    "seg": "s12",
    "start": 66.934,
    "end": 68.529
  },
  {
    "text": "اعتذر وإذا كانت مجرد كلمة تعثّرت فيها",
    "seg": "s12",
    "start": 68.529,
    "end": 71.969
  },
  {
    "text": "صحّحها وكمّل",
    "seg": "s12",
    "start": 72.359,
    "end": 73.172
  },
  {
    "text": "ورجّع انتباهك للي قدامك",
    "seg": "s13",
    "start": 73.449,
    "end": 75.409
  },
  {
    "text": "إيش يقول؟ وإيش تبغى توصل له؟",
    "seg": "s13",
    "start": 75.409,
    "end": 77.474
  },
  {
    "text": "قبل ما تعيد المشهد للمرة العاشرة…",
    "seg": "s14",
    "start": 79.064,
    "end": 81.42
  },
  {
    "text": "تذكّر اللي كبير في تجربتك",
    "seg": "s14",
    "start": 81.42,
    "end": 83.7
  },
  {
    "text": "ممكن يكون أصغر عند غيرك",
    "seg": "s14",
    "start": 83.7,
    "end": 85.5
  }
]
