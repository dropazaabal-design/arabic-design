{
  "name": "idea-flight",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/video/index.ts",
    "render": "remotion render src/video/index.ts Reel out/reel-raw.mp4 --audio-codec=aac --audio-bitrate=192k",
    "cover": "remotion still src/video/index.ts Reel out/cover.png --frame=744 && ffmpeg -v error -y -i out/cover.png -q:v 2 publish/cover-1080x1920.jpg",
    "test:render": "node tools/render-tests.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  }
}
