      "id": "s04",
      "take": "N",
      "role": "N",
      "sceneId": "predict",
      "tag": "[dramatic]",
      "text": "النتيجة؟ ستة وعشرين من أربعين… وصلوا لآخر زر: أربعمية وخمسين فولت."
    },
    {
      "id": "s05",
      "take": "E",
      "role": "X",
      "sceneId": "wall",
      "tag": "[firm]",
      "text": "التجربة تتطلّب أن تستمر."
    },
    {
      "id": "s06",
      "take": "N",
      "role": "N",
      "sceneId": "wall",
      "tag": "",
      "text": "الرجل خلف الجدار طرق… ثم سكت."
    },
    {
      "id": "s07",
      "take": "E",
      "role": "X",
      "sceneId": "wall",
      "tag": "[cold]",
      "text": "ليس لديك خيار آخر… يجب أن تستمر."
    },
    {
      "id": "s08",
      "take": "N",
      "role": "N",
      "sceneId": "wall",
      "tag": "",
      "text": "وكمّلوا."
    },
    {
      "id": "s09",
      "take": "N",
      "role": "N",
      "sceneId": "reveal",
      "tag": "[relieved]",
      "text": "الخبر الطيب: كان ممثل، والصعق مو حقيقي."
    },
    {
      "id": "s10",
      "take": "N",
      "role": "N",
      "sceneId": "reveal",
      "tag": "[serious]",
      "text": "الخبر السيئ: محد قال لهم."
    },
    {
      "id": "s11",
      "take": "N",
      "role": "N",
      "sceneId": "asch",
      "tag": "",
      "text": "وما تحتاج معطف… تكفي جماعة."
    },
    {
      "id": "s12",
      "take": "N",
      "role": "N",
      "sceneId": "asch",
      "tag": "",
      "text": "تجربة آش: خط واضح، والكل حولك يقول الجواب الغلط."
    },
    {
      "id": "s13",
      "take": "N",
      "role": "N",
      "sceneId": "asch",
      "tag": "",
      "text": "لوحدهم ما غلطوا تقريبًا. وسط الجماعة؟ مشوا مع الغلط في سبعة وثلاثين بالمية من الإجابات."
    },
    {
      "id": "s14",
      "take": "N",
      "role": "N",
      "sceneId": "today",
      "tag": "[provocative]",
      "text": "تقول هذا زمان؟ أعادوا تجربة ميلغرام سنة ألفين وستة… والنسب قريبة."
    },
    {
      "id": "s15",
      "take": "N",
      "role": "N",
      "sceneId": "partner",
      "tag": "[curious]",
      "text": "طيب… وش يكسر الضغط؟ شخص واحد يقول الصح."
    },
    {
      "id": "s16",
      "take": "N",
      "role": "N",
      "sceneId": "partner",
      "tag": "",
      "text": "لما كان مع المشارك شريك واحد صادق… نزل الغلط للربع."
    },
    {
      "id": "s17",
      "take": "N",
      "role": "N",
      "sceneId": "close",
      "tag": "[warmly]",
      "text": "الامتثال الأعمى مو غباء… هو ضغط. والسؤال: تكون أنت الشريك؟"
    },
    {
      "id": "s18",
      "take": "N",
      "role": "N",
      "sceneId": "cta",
      "tag": "[provocative]",
      "text": "لو كنت بالغرفة… كنت بتضغط؟ قلها بصراحة في التعليقات… وتابعنا."
    }
