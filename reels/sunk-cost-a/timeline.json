 },
 "segments": [
  {
   "id": "s01",
   "text": "مية وخمسين… على تذكرة فيلم.",
   "start": 0.35,
   "end": 2.67,
   "duration": 2.32,
   "fileStart": 0.25,
   "file": "audio/voice/s01.wav",
   "measured": true
  },
  {
   "id": "s02",
   "text": "وبعد عشر دقايق… عرفت إن الفيلم سيئ.",
   "start": 4.45,
   "end": 7.27,
   "duration": 2.82,
   "fileStart": 4.42,
   "file": "audio/voice/s02.wav",
   "measured": true
  },
  {
   "id": "s03",
   "text": "سيئ جدًا.",
   "start": 8.41,
   "end": 9.27,
   "duration": 0.86,
   "fileStart": 8.295,
   "file": "audio/voice/s03.wav",
   "measured": true
  },
  {
   "id": "s04",
   "text": "تطالع باب الخروج…",
   "start": 10.29,
   "end": 11.43,
   "duration": 1.14,
   "fileStart": 10.24,
   "file": "audio/voice/s04.wav",
   "measured": true
  },
  {
   "id": "s05",
   "text": "تطالع التذكرة…",
   "start": 12.19,
   "end": 13.11,
   "duration": 0.92,
   "fileStart": 12.145,
   "file": "audio/voice/s05.wav",
   "measured": true
  },
  {
   "id": "s06",
   "text": "وترجع تقعد.",
   "start": 14.41,
   "end": 15.21,
   "duration": 0.8,
   "fileStart": 13.7,
   "file": "audio/voice/s06.wav",
   "measured": true
  },
  {
   "id": "s07",
   "text": "ساعة… ساعتين… الفشار خلص، والناس طلعوا واحد واحد.",
   "start": 16.67,
   "end": 20.95,
   "duration": 4.28,
   "fileStart": 16.345,
   "file": "audio/voice/s07.wav",
   "measured": true
  },
  {
   "id": "s08",
   "text": "والديناصور؟ صار يغني.",
   "start": 21.83,
   "end": 23.49,
   "duration": 1.66,
   "fileStart": 21.759,
   "file": "audio/voice/s08.wav",
   "measured": true
  },
  {
   "id": "s09",
   "text": "وأنت باقي. ليش؟ \"دفعت… ما أبي فلوسي تروح على الفاضي.\"",
   "start": 24.77,
   "end": 28.67,
   "duration": 3.9,
   "fileStart": 24.688,
   "file": "audio/voice/s09.wav",
   "measured": true
  },
  {
   "id": "s10",
   "text": "بس الفلوس راحت. راحت لو قعدت… وراحت لو طلعت.",
   "start": 29.55,
   "end": 33.05,
   "duration": 3.5,
   "fileStart": 29.456,
   "file": "audio/voice/s10.wav",
   "measured": true
  },
  {
   "id": "s11",
   "text": "هذي اسمها: مغالطة التكلفة الغارقة.",
   "start": 34.11,
   "end": 36.75,
   "duration": 2.64,
   "fileStart": 34.037,
   "file": "audio/voice/s11.wav",
   "measured": true
  },
  {
   "id": "s12",
   "text": "تكمّل في شي ما ينفعك… عشان شي صرفته وما يرجع: فلوس، أو وقت، أو تعب.",
   "start": 37.37,
   "end": 42.45,
   "duration": 5.08,
   "fileStart": 37.329,
   "file": "audio/voice/s12.wav",
   "measured": true
  },
  {
   "id": "s13",
   "text": "وفي تجربة حقيقية على تذاكر مسرح: اللي دفعوا السعر كامل… استعملوا تذاكرهم أكثر من اللي أخذوا خصم، في أول ست شهور.",
   "start": 43.39,
   "end": 50.95,
   "duration": 7.56,
   "fileStart": 43.358,
   "file": "audio/voice/s13.wav",
   "measured": true
  },
  {
   "id": "s14",
   "text": "والباحثين نفسهم توقّعوا: أفلام سيئة كثيرة تنشاف لآخرها… لهذا السبب.",
   "start": 51.61,
   "end": 56.35,
   "duration": 4.74,
   "fileStart": 51.526,
   "file": "audio/voice/s14.wav",
   "measured": true
  },
  {
   "id": "s15",
   "text": "مو معناته كل استمرار غلط. لو الفيلم بدأ يحلو… كمّل.",
   "start": 57.41,
   "end": 60.97,
   "duration": 3.56,
   "fileStart": 57.32,
   "file": "audio/voice/s15.wav",
   "measured": true
  },
  {
   "id": "s16",
   "text": "بس كمّل عشان الساعة الجاية… مو عشان التذكرة.",
   "start": 61.49,
   "end": 64.27,
   "duration": 2.78,
   "fileStart": 61.418,
   "file": "audio/voice/s16.wav",
   "measured": true
  },
  {
   "id": "s17",
   "text": "الفلوس ما رجعت… بس رجعت لك ساعتين.",
   "start": 65.89,
   "end": 68.33,
   "duration": 2.44,
   "fileStart": 65.845,
   "file": "audio/voice/s17.wav",
   "measured": true
  },
  {
   "id": "s18",
   "text": "لو بدأت اليوم من الصفر… هل كنت ستختار الشيء نفسه؟",
   "start": 69.59,
   "end": 72.65,
   "duration": 3.06,
   "fileStart": 69.504,
   "file": "audio/voice/s18.wav",
   "measured": true
  },
  {
   "id": "s19",
   "text": "قلها في التعليقات… وتابعنا.",
   "start": 73.45,
   "end": 75.15,
   "duration": 1.7,
   "fileStart": 73.331,
   "file": "audio/voice/s19.wav",
   "measured": true
  }
 ]
}
