{
  "name": "sunk-cost-a",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/video/index.ts",
    "voice": "python3 ../tools/voice_timeline.py .",
    "sfx": "python3 tools/sfx.py",
    "storyboard": "python3 ../tools/storyboard.py .",
    "mix": "AUDIO_ONLY=1 remotion render src/video/index.ts Reel out/mix.wav --codec=wav --log=error",
    "render": "bash ../tools/render_final.sh .",
    "cover": "remotion still src/video/index.ts Cover out/cover.png --frame=1614 && ffmpeg -v error -y -i out/cover.png -q:v 2 publish/cover-1080x1920.jpg",
    "check": "node ../tools/render_check.mjs",
    "gates": "python3 ../tools/qa_gates.py . --measure",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.534",
    "typescript": "^7.0.2"
  }
}
