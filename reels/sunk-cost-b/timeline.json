 },
 "segments": [
  {
   "id": "s01",
   "text": "صاحبنا ركب الباص… وبعد دقيقة: الباص رايح بالعكس.",
   "start": 0.3,
   "end": 4.42,
   "duration": 4.12,
   "fileStart": 0.22,
   "file": "audio/voice/s01.wav",
   "measured": true
  },
  {
   "id": "s02",
   "text": "المحطة الجاية قريبة. ينزل؟",
   "start": 5.4,
   "end": 7.22,
   "duration": 1.82,
   "fileStart": 5.371,
   "file": "audio/voice/s02.wav",
   "measured": true
  },
  {
   "id": "s03",
   "text": "لا. \"قطعت مسافة… حرام تروح على الفاضي.\"",
   "start": 8.2,
   "end": 11.22,
   "duration": 3.02,
   "fileStart": 8.051,
   "file": "audio/voice/s03.wav",
   "measured": true
  },
  {
   "id": "s04",
   "text": "الخالة اللي جنبه؟ نزلت… قطعت الشارع… وركبت الباص الصح.",
   "start": 12.08,
   "end": 16.26,
   "duration": 4.18,
   "fileStart": 12.029,
   "file": "audio/voice/s04.wav",
   "measured": true
  },
  {
   "id": "s05",
   "text": "وصاحبنا؟ اشترى تذكرة ثانية.",
   "start": 17.44,
   "end": 19.46,
   "duration": 2.02,
   "fileStart": 17.412,
   "file": "audio/voice/s05.wav",
   "measured": true
  },
  {
   "id": "s06",
   "text": "المدينة صارت مزارع… والمزارع صارت صحرا.",
   "start": 20.38,
   "end": 23.44,
   "duration": 3.06,
   "fileStart": 20.347,
   "file": "audio/voice/s06.wav",
   "measured": true
  },
  {
   "id": "s07",
   "text": "وكل ما بعد… لقى سبب جديد يكمّل.",
   "start": 24.1,
   "end": 26.56,
   "duration": 2.46,
   "fileStart": 24.071,
   "file": "audio/voice/s07.wav",
   "measured": true
  },
  {
   "id": "s08",
   "text": "\"دفعت كثير.\" \"أكيد يلف ويرجع.\"",
   "start": 27.24,
   "end": 29.42,
   "duration": 2.18,
   "fileStart": 27.147,
   "file": "audio/voice/s08.wav",
   "measured": true
  },
  {
   "id": "s09",
   "text": "والسبب الحقيقي: \"لو نزلت الحين… يعني غلطت من البداية.\"",
   "start": 30.16,
   "end": 33.9,
   "duration": 3.74,
   "fileStart": 30.106,
   "file": "audio/voice/s09.wav",
   "measured": true
  },
  {
   "id": "s10",
   "text": "هذي مغالطة التكلفة الغارقة: الطريق اللي قطعته… غرق وراك. ما يرجع، نزلت أو كمّلت.",
   "start": 34.92,
   "end": 41.74,
   "duration": 6.82,
   "fileStart": 34.827,
   "file": "audio/voice/s10.wav",
   "measured": true
  },
  {
   "id": "s11",
   "text": "والسؤال الوحيد المفيد: من مكاني الحين… وين أقرب طريق؟",
   "start": 42.48,
   "end": 46.06,
   "duration": 3.58,
   "fileStart": 42.427,
   "file": "audio/voice/s11.wav",
   "measured": true
  },
  {
   "id": "s12",
   "text": "بس صاحبنا… علّق صورة، وزرع نبتة، وصار الباص بيته.",
   "start": 47.22,
   "end": 51.18,
   "duration": 3.96,
   "fileStart": 47.11,
   "file": "audio/voice/s12.wav",
   "measured": true
  },
  {
   "id": "s13",
   "text": "ثلج… بحر… وسنين.",
   "start": 52.04,
   "end": 53.76,
   "duration": 1.72,
   "fileStart": 51.927,
   "file": "audio/voice/s13.wav",
   "measured": true
  },
  {
   "id": "s14",
   "text": "وأخيرًا… وصل! من الجهة الثانية من الكرة الأرضية.",
   "start": 55.28,
   "end": 58.54,
   "duration": 3.26,
   "fileStart": 55.208,
   "file": "audio/voice/s14.wav",
   "measured": true
  },
  {
   "id": "s15",
   "text": "المحطة اللي يبيها… كانت قدام محطته الأولى، بالضبط.",
   "start": 59.28,
   "end": 62.76,
   "duration": 3.48,
   "fileStart": 59.226,
   "file": "audio/voice/s15.wav",
   "measured": true
  },
  {
   "id": "s16",
   "text": "والخالة؟ وصلت قبله… بأربعين سنة.",
   "start": 63.66,
   "end": 66.28,
   "duration": 2.62,
   "fileStart": 63.596,
   "file": "audio/voice/s16.wav",
   "measured": true
  },
  {
   "id": "s17",
   "text": "مو غلط تكمّل… لو الطريق فعلًا يقرّبك. بس اسأل عن اللي قدامك… مو عن اللي وراك.",
   "start": 67.54,
   "end": 72.78,
   "duration": 5.24,
   "fileStart": 67.447,
   "file": "audio/voice/s17.wav",
   "measured": true
  },
  {
   "id": "s18",
   "text": "لو بدأت اليوم من الصفر… هل كنت ستختار الشيء نفسه؟",
   "start": 73.94,
   "end": 76.96,
   "duration": 3.02,
   "fileStart": 73.721,
   "file": "audio/voice/s18.wav",
   "measured": true
  },
  {
   "id": "s19",
   "text": "اكتبها في التعليقات… وتابعنا.",
   "start": 77.78,
   "end": 79.58,
   "duration": 1.8,
   "fileStart": 77.716,
   "file": "audio/voice/s19.wav",
   "measured": true
  }
 ]
}
