 "captions": [
  {
   "seg": "R1",
   "text": "سلطان اشترى حذاء رياضة غالي…",
   "start": 0.333,
   "end": 2.74,
   "cps": 11.6
  },
  {
   "seg": "R1",
   "text": "وصار له شهر في كرتونه.",
   "start": 2.79,
   "end": 4.815,
   "cps": 10.9
  },
  {
   "seg": "R2",
   "text": "كان يبي يرجع لياقته، فكتب خطة ما تنكسر:",
   "start": 4.865,
   "end": 8.13,
   "cps": 11.9
  },
  {
   "seg": "R2",
   "text": "ساعة رياضة كل يوم، الساعة خمس ونص الفجر.",
   "start": 8.18,
   "end": 11.81,
   "cps": 11.0
  },
  {
   "seg": "R3",
   "text": "أول يوم رنّ المنبه. شاف الكرتون…",
   "start": 11.86,
   "end": 15.279,
   "cps": 9.4
  },
  {
   "seg": "R3",
   "text": "وتخيّل الساعة كاملة… ورجع نام.",
   "start": 15.329,
   "end": 18.594,
   "cps": 9.2
  },
  {
   "seg": "R3",
   "text": "وكل ليلة يعوّض بخطة أكبر: بكرة ساعتين!",
   "start": 18.644,
   "end": 22.832,
   "cps": 9.1
  },
  {
   "seg": "R4",
   "text": "جيمس كلير، في كتاب «العادات الذرية»، عنده قاعدة بسيطة:",
   "start": 22.882,
   "end": 27.649,
   "cps": 11.3
  },
  {
   "seg": "R4",
   "text": "أي عادة جديدة، ابدأها بنسخة تاخذ أقل من دقيقتين.",
   "start": 27.699,
   "end": 32.347,
   "cps": 10.3
  },
  {
   "seg": "R4",
   "text": "مو تقرأ كتاب؛ تقرأ صفحة. مو تركض ساعة؛ تلبس الحذاء بس.",
   "start": 32.397,
   "end": 37.583,
   "cps": 10.4
  },
  {
   "seg": "R5",
   "text": "لأن العادة، بمعنى كلامه، لازم توجد أول… قبل ما تتحسن.",
   "start": 37.633,
   "end": 42.745,
   "cps": 10.4
  },
  {
   "seg": "R6",
   "text": "فسلطان شطب الساعتين، وكتب: ألبس الحذاء.",
   "start": 42.795,
   "end": 47.042,
   "cps": 9.2
  },
  {
   "seg": "R6",
   "text": "وفتح الكرتون أخيرًا.",
   "start": 47.092,
   "end": 49.697,
   "cps": 7.7
  },
  {
   "seg": "R6",
   "text": "أول يوم لبسه وقعد. ثاني يوم وصل الباب.",
   "start": 49.787,
   "end": 54.438,
   "cps": 8.2
  },
  {
   "seg": "R6",
   "text": "وبعد كم أسبوع، صار يطلع يمشي… بدون ما يتفاوض مع نفسه.",
   "start": 54.488,
   "end": 59.168,
   "cps": 11.3
  },
  {
   "seg": "R7",
   "text": "الدقيقتين مو الهدف، هي الباب.",
   "start": 59.218,
   "end": 61.84,
   "cps": 11.1
  },
  {
   "seg": "R7",
   "text": "اختر عادة تبيها، وصغّرها لين ما تقدر تقول لا.",
   "start": 61.89,
   "end": 66.097,
   "cps": 10.7
  },
  {
   "seg": "R7",
   "text": "إيش نسخة الدقيقتين من عادتك؟",
   "start": 66.147,
   "end": 69.367,
   "cps": 8.7
  }
 ]
}
