[
  {
    "start": 0.7,
    "end": 1.876,
    "text": "قطعة واحدة..."
  },
  {
    "start": 1.896,
    "end": 3.212,
    "text": "وبعدها سأرتاح."
  },
  {
    "start": 3.831,
    "end": 5.24,
    "text": "هكذا تبدأ الجولة."
  },
  {
    "start": 5.282,
    "end": 7.132,
    "text": "ليست البطة هي التي تسحبه؛"
  },
  {
    "start": 7.163,
    "end": 8.908000000000001,
    "text": "إنه وعد الراحة حين تصبح"
  },
  {
    "start": 8.928,
    "end": 9.384,
    "text": "له."
  },
  {
    "start": 9.404,
    "end": 10.463000000000001,
    "text": "عند شوبنهاور،"
  },
  {
    "start": 10.483,
    "end": 12.577,
    "text": "تنطلق الرغبة من إحساس بالنقص."
  },
  {
    "start": 12.597,
    "end": 13.784,
    "text": "ما نريده بعيد،"
  },
  {
    "start": 13.804,
    "end": 15.874,
    "text": "فنركض إليه كأن الراحة تختبئ"
  },
  {
    "start": 15.894,
    "end": 16.894,
    "text": "داخله."
  },
  {
    "start": 17.037,
    "end": 17.702,
    "text": "أخيرا!"
  },
  {
    "start": 17.722,
    "end": 18.758,
    "text": "وصلت البطة."
  },
  {
    "start": 18.778,
    "end": 20.14,
    "text": "وسكن النقص لحظة."
  },
  {
    "start": 20.836,
    "end": 22.511,
    "text": "لكن الراحة لم تتحول إلى"
  },
  {
    "start": 22.531,
    "end": 23.531,
    "text": "عيد دائم."
  },
  {
    "start": 24.414,
    "end": 26.182000000000002,
    "text": "اليد تقول: اكتفيت."
  },
  {
    "start": 26.202,
    "end": 28.446,
    "text": "والقدم تقول: جولة أخرى."
  },
  {
    "start": 28.819,
    "end": 30.506,
    "text": "حين لا يبقى شيء نطلبه،"
  },
  {
    "start": 30.526,
    "end": 31.562,
    "text": "قد يأتي الملل."
  },
  {
    "start": 31.582,
    "end": 33.803,
    "text": "فتفتح الأمنية التالية بابها..."
  },
  {
    "start": 33.823,
    "end": 36.217999999999996,
    "text": "وتحتاج إلى ذراعين إضافيتين."
  },
  {
    "start": 36.915,
    "end": 38.903,
    "text": "هنا بندوله: ألم السعي من"
  },
  {
    "start": 38.923,
    "end": 39.263,
    "text": "جهة،"
  },
  {
    "start": 39.283,
    "end": 40.83,
    "text": "والملل من جهة أخرى."
  },
  {
    "start": 40.85,
    "end": 42.537,
    "text": "هذه رؤيته الفلسفية؛"
  },
  {
    "start": 42.557,
    "end": 44.372,
    "text": "ليست قانونا لكل شعور."
  },
  {
    "start": 44.726,
    "end": 46.413,
    "text": "وحين حاول الهرب من الآلة،"
  },
  {
    "start": 46.433,
    "end": 48.144,
    "text": "وجد طرف الخيط في يده."
  },
  {
    "start": 48.698,
    "end": 49.687999999999995,
    "text": "ثم رأى الظل."
  },
  {
    "start": 49.708,
    "end": 50.477,
    "text": "للحظات،"
  },
  {
    "start": 50.497,
    "end": 52.196,
    "text": "لم يسأل: كيف أملكه؟"
  },
  {
    "start": 52.216,
    "end": 53.693999999999996,
    "text": "بل انتبه إلى شكله."
  },
  {
    "start": 53.748,
    "end": 56.096,
    "text": "والتأمل الفني في رؤيته فسحة"
  },
  {
    "start": 56.116,
    "end": 57.593999999999994,
    "text": "مؤقتة من المطالبة،"
  },
  {
    "start": 57.614,
    "end": 58.907,
    "text": "لا نهاية للرغبة."
  },
  {
    "start": 59.396,
    "end": 60.083999999999996,
    "text": "جميل..."
  },
  {
    "start": 60.104,
    "end": 61.918,
    "text": "لكن البطة الكبيرة لا تمر"
  },
  {
    "start": 61.938,
    "end": 62.938,
    "text": "من الباب."
  },
  {
    "start": 63.27,
    "end": 64.10900000000001,
    "text": "وربما..."
  },
  {
    "start": 64.129,
    "end": 65.491,
    "text": "جولة أخيرة؟"
  }
]