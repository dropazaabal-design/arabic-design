[
 {
  "start": 0.3,
  "end": 3.44,
  "text": "هل تقدر تجلس دقيقتين بلا هاتف؟"
 },
 {
  "start": 3.74,
  "end": 6.82,
  "text": "جرّب، ولاحظ كم مرة ترغب في فتحه"
 },
 {
  "start": 6.82,
  "end": 8.76,
  "text": "حتى من دون إشعار"
 },
 {
  "start": 8.76,
  "end": 11.64,
  "text": "الفكرة ليست اختبار قوة إرادتك"
 },
 {
  "start": 11.64,
  "end": 12.9,
  "text": "بل ملاحظة عادة"
 },
 {
  "start": 12.9,
  "end": 14.96,
  "text": "قد تمرّ من دون انتباه"
 },
 {
  "start": 15.06,
  "end": 16.82,
  "text": "وفي تجربة منشورة"
 },
 {
  "start": 16.82,
  "end": 19.06,
  "text": "حُجب إنترنت الهاتف أسبوعين"
 },
 {
  "start": 19.06,
  "end": 20.32,
  "text": "مع بقاء المكالمات"
 },
 {
  "start": 20.32,
  "end": 21.66,
  "text": "والرسائل النصية"
 },
 {
  "start": 21.66,
  "end": 23.66,
  "text": "تحسّن الانتباه المستمر"
 },
 {
  "start": 23.66,
  "end": 26.72,
  "text": "لكن الالتزام لم يكن سهلًا"
 },
 {
  "start": 26.72,
  "end": 28.3,
  "text": "هذا لا يعني أن دقيقتين"
 },
 {
  "start": 28.3,
  "end": 29.92,
  "text": "تعيدان ضبط دماغك"
 },
 {
  "start": 29.92,
  "end": 33.02,
  "text": "ابدأ بهما فقط: ضع الهاتف بعيدًا"
 },
 {
  "start": 33.02,
  "end": 35.02,
  "text": "ثم اختر ما تريد فعله"
 },
 {
  "start": 35.22,
  "end": 38.3,
  "text": "بعد التجربة: هل فتحت الهاتف لسبب"
 },
 {
  "start": 38.3,
  "end": 40.04,
  "text": "أم لمجرد العادة؟"
 }
]
