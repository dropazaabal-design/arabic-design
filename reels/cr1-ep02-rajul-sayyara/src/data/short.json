   "text": "وأول ما وقّفها… التفتوا كلهم.",
   "start": 3.982,
   "end": 7.176,
   "cps": 9.1
  },
  {
   "seg": "R1",
   "text": "بس ولا واحد كان يفكر في ماجد.",
   "start": 7.226,
   "end": 9.555,
   "cps": 12.5
  },
  {
   "seg": "R1",
   "text": "كل واحد كان يتخيّل نفسه هو اللي ورا المقود.",
   "start": 9.605,
   "end": 13.013,
   "cps": 12.6
  },
  {
   "seg": "R2",
   "text": "مورجان هاوسل، في كتاب «سيكولوجية المال»،",
   "start": 13.063,
   "end": 15.86,
   "cps": 14.3
  },
  {
   "seg": "R2",
   "text": "يسمّيها «مفارقة الرجل في السيارة»:",
   "start": 15.91,
   "end": 18.823,
   "cps": 11.7
  },
  {
   "seg": "R2",
   "text": "نريد الشيء الفاخر عشان الناس تعجب فينا،",
   "start": 18.873,
   "end": 21.852,
   "cps": 13.1
  },
  {
   "seg": "R2",
   "text": "والناس تشوف فيه نفسها، مو إحنا.",
   "start": 21.902,
   "end": 24.461,
   "cps": 12.1
  },
  {
   "seg": "R3",
   "text": "وجنب ماجد، سيارة قديمة ما أحد يلتفت لها: سيارة سعد.",
   "start": 24.511,
   "end": 29.03,
   "cps": 11.3
  },
  {
   "seg": "R3",
   "text": "ولما جت فرصة يحبونها، براتب أقل في البداية،",
   "start": 29.08,
   "end": 32.448,
   "cps": 12.8
  },
  {
   "seg": "R3",
   "text": "ماجد ما قدر، القسط ما ينتظر.",
   "start": 32.498,
   "end": 35.29,
   "cps": 10.0
  },
  {
   "seg": "R3",
   "text": "وسعد قال: نعم.",
   "start": 35.34,
   "end": 37.713,
   "cps": 5.9
  },
  {
   "seg": "R4",
   "text": "لأن الثروة، بمعنى كلام هاوسل، هي اللي ما تشوفه:",
   "start": 37.763,
   "end": 41.395,
   "cps": 12.9
  },
  {
   "seg": "R4",
   "text": "السيارة اللي ما اشتريتها.",
   "start": 41.445,
   "end": 43.291,
   "cps": 13.5
  },
  {
   "seg": "R4",
   "text": "وأعلى عائد يعطيك إياه المال: إنك تتحكم في وقتك.",
   "start": 43.341,
   "end": 47.402,
   "cps": 11.6
  },
  {
   "seg": "R5",
   "text": "ومو كل سيارة فخمة دين، ولا كل سيارة قديمة ثروة.",
   "start": 47.452,
   "end": 51.556,
   "cps": 11.5
  },
  {
   "seg": "R5",
   "text": "السؤال: لمين تصرف؟",
   "start": 51.606,
   "end": 53.536,
   "cps": 9.3
  },
  {
   "seg": "R6",
   "text": "فقبل ما تشتري شيء كبير، اسأل:",
   "start": 53.586,
   "end": 56.001,
   "cps": 12.0
  },
  {
   "seg": "R6",
   "text": "لو ما أحد بيشوفه… كنت بتشتريه؟",
   "start": 56.051,
   "end": 58.756,
   "cps": 11.1
  },
  {
   "seg": "R6",
   "text": "وأنت، إيش آخر شيء اشتريته وأنت تفكر مين بيشوفه؟",
   "start": 58.806,
   "end": 64.366,
   "cps": 8.5
  }
 ]
}
