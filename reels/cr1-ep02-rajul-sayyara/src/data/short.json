   "start": 4.183,
   "end": 6.988
  },
  {
   "seg": "R1",
   "text": "بس ولا واحد كان يفكر في ماجد.",
   "start": 7.048,
   "end": 9.637
  },
  {
   "seg": "R1",
   "text": "كل واحد كان يتخيّل نفسه هو اللي ورا المقود.",
   "start": 9.697,
   "end": 13.363
  },
  {
   "seg": "R2",
   "text": "مورجان هاوسل، في كتاب «سيكولوجية المال»،",
   "start": 13.873,
   "end": 17.222
  },
  {
   "seg": "R2",
   "text": "يسمّيها «مفارقة الرجل في السيارة»:",
   "start": 17.282,
   "end": 20.05
  },
  {
   "seg": "R2",
   "text": "نريد الشيء الفاخر عشان الناس تعجب فينا،",
   "start": 20.11,
   "end": 23.435
  },
  {
   "seg": "R2",
   "text": "والناس تشوف فيه نفسها، مو إحنا.",
   "start": 23.495,
   "end": 26.366
  },
  {
   "seg": "R3",
   "text": "وجنب ماجد، سيارة قديمة ما أحد يلتفت لها: سيارة سعد.",
   "start": 26.876,
   "end": 31.563
  },
  {
   "seg": "R3",
   "text": "ولما جت فرصة يحبونها، براتب أقل في البداية،",
   "start": 31.623,
   "end": 35.361
  },
  {
   "seg": "R3",
   "text": "ماجد ما قدر، القسط ما ينتظر.",
   "start": 35.421,
   "end": 38.034
  },
  {
   "seg": "R3",
   "text": "وسعد قال: نعم.",
   "start": 38.094,
   "end": 39.654
  },
  {
   "seg": "R4",
   "text": "لأن الثروة، بمعنى كلام هاوسل، هي اللي ما تشوفه:",
   "start": 40.164,
   "end": 44.402
  },
  {
   "seg": "R4",
   "text": "السيارة اللي ما اشتريتها.",
   "start": 44.462,
   "end": 46.771
  },
  {
   "seg": "R4",
   "text": "وأعلى عائد يعطيك إياه المال: إنك تتحكم في وقتك.",
   "start": 46.831,
   "end": 51.105
  },
  {
   "seg": "R5",
   "text": "ومو كل سيارة فخمة دين، ولا كل سيارة قديمة ثروة.",
   "start": 51.615,
   "end": 55.78
  },
  {
   "seg": "R5",
   "text": "السؤال: لمين تصرف؟",
   "start": 55.84,
   "end": 57.86
  },
  {
   "seg": "R6",
   "text": "فقبل ما تشتري شيء كبير، اسأل:",
   "start": 58.37,
   "end": 61.034
  },
  {
   "seg": "R6",
   "text": "لو ما أحد بيشوفه… كنت بتشتريه؟",
   "start": 61.094,
   "end": 64.165
  },
  {
   "seg": "R6",
   "text": "وأنت، إيش آخر شيء اشتريته وأنت تفكر مين بيشوفه؟",
   "start": 64.225,
   "end": 68.527
  }
 ]
}
