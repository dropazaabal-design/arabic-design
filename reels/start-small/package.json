{
  "name": "start-small-reel",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts StartSmall out/start-small.mp4 --audio-codec=aac",
    "timeline": "node tools/timeline.mjs",
    "proof": "node tools/proof.mjs out/proof",
    "assets": "esbuild tools/export-assets.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=out/export.mjs --log-level=error && node out/export.mjs && rm out/export.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "@remotion/renderer": "^4.0.534",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534",
    "typescript": "^7.0.2"
  }
}
