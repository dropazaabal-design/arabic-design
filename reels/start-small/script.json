    { "scene": 4, "role": "label", "text": "تمرين بسيط" },
    { "scene": 5, "role": "title", "text": "وقت محدد… وأدوات جاهزة" },
    { "scene": 6, "role": "title", "text": "فاتك يوم؟ ارجع بكرة" },
    { "scene": 7, "role": "title", "text": "سهلت؟ زِد خطوة" },
