{
  "title": "ليش تبدأ بحماس… وبعدين تتوقف؟",
  "register": "عامية عربية بيضاء",
  "voice": "kitabwbs_nadeem — see ../voices/nadeem/profile.json",
  "segments": [
    { "id": "s1",  "scene": 1, "text": "تعرف أول يوم، لما تقرر تغيّر حياتك كلها؟" },
    { "id": "s2",  "scene": 2, "text": "رياضة، وقراءة، وشغل… وكل هذا من بكرة." },
    { "id": "s3",  "scene": 3, "text": "وبعد كم يوم… تتوقف." },
    { "id": "s4",  "scene": 3, "text": "ممكن البداية نفسها كانت أكبر من وقتك وطاقتك." },
    { "id": "s5",  "scene": 4, "text": "جرّب تصغّرها." },
    { "id": "s6",  "scene": 4, "text": "بدل ساعة قراءة، ابدأ بصفحتين." },
    { "id": "s7",  "scene": 4, "text": "وبدل خطة رياضية ضخمة، اختار تمرين بسيط." },
    { "id": "s8",  "scene": 5, "text": "حدّد له وقت، وجهّز اللي تحتاجه قبلها." },
    { "id": "s9",  "scene": 6, "text": "وإذا فاتك يوم، ارجع في اليوم اللي بعده." },
    { "id": "s10", "scene": 7, "text": "بعد ما يصير أسهل عليك، زِد خطوة." },
    { "id": "s11", "scene": 8, "text": "مو لازم تعمل كل شيء اليوم." },
    { "id": "s12", "scene": 8, "text": "خلّ عندك شيء واضح… تقدر ترجع له بكرة." }
  ],
  "onScreen": [
    { "scene": 1, "role": "title", "text": "تبدأ بحماس… وبعدين تتوقف؟" },
