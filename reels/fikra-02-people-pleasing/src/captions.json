[
  {
    "text": "تصلك رسالة من زميل",
    "seg": "s01",
    "start": 0.5,
    "end": 2.6
  },
  {
    "text": "«ممكن تساعدني اليوم؟»",
    "seg": "s01",
    "start": 2.6,
    "end": 3.824
  },
  {
    "text": "تكتب «لا أستطيع اليوم»…",
    "seg": "s02",
    "start": 4.3,
    "end": 6.4
  },
  {
    "text": "ثم تمسحها",
    "seg": "s02",
    "start": 6.4,
    "end": 7.436
  },
  {
    "text": "وترسل «حاضر»",
    "seg": "s03",
    "start": 7.704,
    "end": 9.094
  },
  {
    "text": "وبقية اليوم؟",
    "seg": "s04",
    "start": 9.458,
    "end": 10.68
  },
  {
    "text": "غاضبٌ من نفسك",
    "seg": "s04",
    "start": 10.68,
    "end": 12.14
  },
  {
    "text": "فلماذا وافقت…",
    "seg": "s04",
    "start": 12.14,
    "end": 13.52
  },
  {
    "text": "وأنت تريد أن تقول لا؟",
    "seg": "s04",
    "start": 13.52,
    "end": 14.868
  },
  {
    "text": "الطلب لم يكن عاجلًا",
    "seg": "s05",
    "start": 16.747,
    "end": 18.3
  },
  {
    "text": "وهذا المساء كان محجوزًا لمشروعك",
    "seg": "s05",
    "start": 18.3,
    "end": 20.713
  },
  {
    "text": "لكن «حاضر» أخذت مكانه",
    "seg": "s06",
    "start": 20.924,
    "end": 23.42
  },
  {
    "text": "ساعة… ثم ساعتين",
    "seg": "s06",
    "start": 23.42,
    "end": 25.1
  },
  {
    "text": "وتأجّل المشروع مرة أخرى",
    "seg": "s06",
    "start": 25.1,
    "end": 27.223
  },
  {
    "text": "في هذه الحلقة نفهم ما يحدث في الثانيتين بين «لا» و«حاضر»",
    "seg": "s07",
    "start": 27.46,
    "end": 31.8
  },
  {
    "text": "ونتعلّم وقفة صغيرة قبل الموافقة القادمة",
    "seg": "s07",
    "start": 31.8,
    "end": 35.155
  },
  {
    "text": "والمساعدة نفسها ليست المشكلة",
    "seg": "s08",
    "start": 35.396,
    "end": 37.84
  },
  {
    "text": "المشكلة أن توافق مرة بعد مرة",
    "seg": "s08",
    "start": 37.84,
    "end": 40.48
  },
  {
    "text": "وأنت لا تقدر",
    "seg": "s08",
    "start": 40.48,
    "end": 41.58
  },
  {
    "text": "أو لا تريد",
    "seg": "s08",
    "start": 41.58,
    "end": 42.317
  },
  {
    "text": "في كتاب «توقف عن إرضاء الآخرين»",
    "seg": "s09",
    "start": 43.58,
    "end": 46.1
  },
  {
    "text": "يكتب باتريك كينغ",
    "seg": "s09",
    "start": 46.1,
    "end": 47.52
  },
  {
    "text": "وهو كاتب ومدرب في المهارات الاجتماعية",
    "seg": "s09",
    "start": 47.52,
    "end": 50.1
  },
  {
    "text": "عن هذه العادة بالذات",
    "seg": "s09",
    "start": 50.1,
    "end": 51.587
  },
  {
    "text": "أن نقول «نعم» لنحافظ على رضا الناس",
    "seg": "s10",
    "start": 51.78,
    "end": 54.52
  },
  {
    "text": "حتى حين يكلّفنا ذلك أكثر مما نريد",
    "seg": "s10",
    "start": 54.52,
    "end": 57.38
  },
  {
    "text": "ويتناول ما قد يتركه تكرارها بعد ذلك",
    "seg": "s11",
    "start": 57.66,
    "end": 60.6
  },
  {
    "text": "استياءً وقلقًا",
    "seg": "s11",
    "start": 60.6,
    "end": 62.06
  },
  {
    "text": "ورسالتنا مثال صغير على ذلك",
    "seg": "s12",
    "start": 62.403,
    "end": 64.84
  },
  {
    "text": "طلب بسيط",
    "seg": "s12",
    "start": 64.84,
    "end": 65.92
  },
  {
    "text": "وردّ سريع",
    "seg": "s12",
    "start": 65.92,
    "end": 66.98
  },
  {
    "text": "وثمن يظهر لاحقًا",
    "seg": "s12",
    "start": 66.98,
    "end": 68.487
  },
  {
    "text": "فلنرجع إلى الرسالة",
    "seg": "s13",
    "start": 70.0,
    "end": 71.52
  },
  {
    "text": "في اللحظة التي تصلك",
    "seg": "s13",
    "start": 71.52,
    "end": 72.96
  },
  {
    "text": "يتسابق في رأسك سؤالان",
    "seg": "s13",
    "start": 72.96,
    "end": 74.77
  },
  {
    "text": "الأول «هل سينزعج؟» والثاني",
    "seg": "s14",
    "start": 75.1,
    "end": 77.78
  },
  {
    "text": "«هل أقدر فعلًا؟»",
    "seg": "s14",
    "start": 77.78,
    "end": 78.821
  },
  {
    "text": "السؤال الأول سريع",
    "seg": "s15",
    "start": 79.075,
    "end": 80.64
  },
  {
    "text": "تتخيّل خيبة أمله",
    "seg": "s15",
    "start": 80.64,
    "end": 82.26
  },
  {
    "text": "أو أن يتغيّر رأيه فيك…",
    "seg": "s15",
    "start": 82.26,
    "end": 84.1
  },
  {
    "text": "فيصل الجواب قبل أن تفتح جدولك",
    "seg": "s15",
    "start": 84.1,
    "end": 86.402
  },
  {
    "text": "والجدول؟ لم تنظر إليه أصلًا",
    "seg": "s16",
    "start": 86.62,
    "end": 88.706
  },
  {
    "text": "أما الثاني فيحتاج لحظة",
    "seg": "s17",
    "start": 88.936,
    "end": 90.96
  },
  {
    "text": "أن تنظر في وقتك",
    "seg": "s17",
    "start": 90.96,
    "end": 92.24
  },
  {
    "text": "وفيما وعدت به نفسك",
    "seg": "s17",
    "start": 92.24,
    "end": 93.785
  },
  {
    "text": "وحين يسبق الخوفُ من ردّ الفعل مراجعةَ قدرتك",
    "seg": "s18",
    "start": 94.02,
    "end": 97.34
  },
  {
    "text": "تخرج «حاضر» قبل أن تصبح قرارك",
    "seg": "s18",
    "start": 97.34,
    "end": 99.845
  },
  {
    "text": "قد يختلف السبب من شخص لآخر",
    "seg": "s19",
    "start": 100.069,
    "end": 102.3
  },
  {
    "text": "لكن في رسالتنا",
    "seg": "s19",
    "start": 102.3,
    "end": 103.68
  },
  {
    "text": "هذا ما حدث بالضبط",
    "seg": "s19",
    "start": 103.68,
    "end": 105.067
  },
  {
    "text": "وهنا تصحيحٌ مهم",
    "seg": "s20",
    "start": 106.36,
    "end": 107.92
  },
  {
    "text": "الحل ليس أن تقول «لا» لكل شيء",
    "seg": "s20",
    "start": 107.92,
    "end": 110.3
  },
  {
    "text": "ولا أن ترى في كل طلب استغلالًا",
    "seg": "s20",
    "start": 110.3,
    "end": 112.715
  },
  {
    "text": "الحل ردٌّ واضح",
    "seg": "s21",
    "start": 113.0,
    "end": 114.6
  },
  {
    "text": "لا «نعم» تلقائية",
    "seg": "s21",
    "start": 114.6,
    "end": 116.1
  },
  {
    "text": "ولا «لا» غاضبة",
    "seg": "s21",
    "start": 116.1,
    "end": 117.16
  },
  {
    "text": "ردٌّ يحترم وقتك",
    "seg": "s22",
    "start": 117.359,
    "end": 118.94
  },
  {
    "text": "ويحترم من طلب منك في الوقت نفسه",
    "seg": "s22",
    "start": 118.94,
    "end": 121.256
  },
  {
    "text": "فحين توافق دائمًا",
    "seg": "s23",
    "start": 121.52,
    "end": 123.0
  },
  {
    "text": "تقول من غير قصد",
    "seg": "s23",
    "start": 123.0,
    "end": 124.48
  },
  {
    "text": "وقتي أقل أهمية",
    "seg": "s23",
    "start": 124.48,
    "end": 125.825
  },
  {
    "text": "والوضوح لا يمنع التعاون؛ يجعله اختيارًا…",
    "seg": "s24",
    "start": 126.069,
    "end": 129.28
  },
  {
    "text": "لا ردّ فعل",
    "seg": "s24",
    "start": 129.28,
    "end": 130.035
  },
  {
    "text": "فقد تساعده غدًا وأنت مرتاح",
    "seg": "s25",
    "start": 130.243,
    "end": 132.6
  },
  {
    "text": "بدل أن تساعده اليوم وأنت منزعج",
    "seg": "s25",
    "start": 132.6,
    "end": 134.98
  },
  {
    "text": "فلنُعِد المشهد",
    "seg": "s26",
    "start": 136.76,
    "end": 138.06
  },
  {
    "text": "الرسالة نفسها",
    "seg": "s26",
    "start": 138.06,
    "end": 139.34
  },
  {
    "text": "«ممكن تساعدني اليوم؟»",
    "seg": "s26",
    "start": 139.34,
    "end": 140.521
  },
  {
    "text": "أولًا توقّف",
    "seg": "s27",
    "start": 140.86,
    "end": 142.34
  },
  {
    "text": "لا تكتب شيئًا بعد",
    "seg": "s27",
    "start": 142.34,
    "end": 143.8
  },
  {
    "text": "لا شيء هنا عاجل",
    "seg": "s27",
    "start": 143.8,
    "end": 145.26
  },
  {
    "text": "والرد يحتمل دقيقة",
    "seg": "s27",
    "start": 145.26,
    "end": 146.697
  },
  {
    "text": "ثانيًا راجع قدرتك",
    "seg": "s28",
    "start": 148.122,
    "end": 150.02
  },
  {
    "text": "افتح جدولك قبل لوحة المفاتيح",
    "seg": "s28",
    "start": 150.02,
    "end": 152.62
  },
  {
    "text": "هذا المساء محجوز لمشروعك",
    "seg": "s28",
    "start": 152.62,
    "end": 154.695
  },
  {
    "text": "هل تريد أن تساعده؟",
    "seg": "s29",
    "start": 154.88,
    "end": 156.56
  },
  {
    "text": "ومتى تقدر فعلًا؟",
    "seg": "s29",
    "start": 156.56,
    "end": 157.68
  },
  {
    "text": "ثالثًا أجب بوضوح",
    "seg": "s30",
    "start": 158.0,
    "end": 159.7
  },
  {
    "text": "وباختصار",
    "seg": "s30",
    "start": 159.7,
    "end": 160.413
  },
  {
    "text": "«لا أستطيع اليوم.» وإن كنت تريد المساعدة فعلًا",
    "seg": "s31",
    "start": 160.64,
    "end": 164.26
  },
  {
    "text": "«أقدر غدًا نصف ساعة.»",
    "seg": "s31",
    "start": 164.26,
    "end": 165.77
  },
  {
    "text": "والبديل ليس واجبًا؛ قدّمه فقط إن كنت تريده",
    "seg": "s32",
    "start": 166.04,
    "end": 169.439
  },
  {
    "text": "وإن لم تعرف بعد",
    "seg": "s33",
    "start": 169.74,
    "end": 170.94
  },
  {
    "text": "«سأراجع وقتي وأرد عليك.»",
    "seg": "s33",
    "start": 170.94,
    "end": 172.822
  },
  {
    "text": "لا تحتاج قصة طويلة",
    "seg": "s34",
    "start": 173.1,
    "end": 174.96
  },
  {
    "text": "ولا أعذارًا",
    "seg": "s34",
    "start": 174.96,
    "end": 175.96
  },
  {
    "text": "جملة واضحة تكفي",
    "seg": "s34",
    "start": 175.96,
    "end": 177.532
  },
  {
    "text": "وقد تشعر بعدها بشيء من عدم الارتياح",
    "seg": "s35",
    "start": 178.769,
    "end": 181.76
  },
  {
    "text": "وقد ينزعج قليلًا",
    "seg": "s35",
    "start": 181.76,
    "end": 183.06
  },
  {
    "text": "هذا وارد",
    "seg": "s35",
    "start": 183.06,
    "end": 184.002
  },
  {
    "text": "وقد يرد ببساطة",
    "seg": "s36",
    "start": 184.183,
    "end": 185.66
  },
  {
    "text": "«تمام غدًا إذن»",
    "seg": "s36",
    "start": 185.66,
    "end": 186.955
  },
  {
    "text": "الرد الواضح لا يضمن رضا الجميع",
    "seg": "s37",
    "start": 187.26,
    "end": 189.52
  },
  {
    "text": "لكنه يجعل قرارك…",
    "seg": "s37",
    "start": 189.52,
    "end": 191.32
  },
  {
    "text": "قرارك",
    "seg": "s37",
    "start": 191.32,
    "end": 191.894
  },
  {
    "text": "ابدأ بالطلبات الصغيرة",
    "seg": "s38",
    "start": 192.142,
    "end": 193.76
  },
  {
    "text": "حيث لا يكلّف الخطأ كثيرًا",
    "seg": "s38",
    "start": 193.76,
    "end": 195.9
  },
  {
    "text": "فالمهارة تحتاج وقتًا وتدريبًا",
    "seg": "s38",
    "start": 195.9,
    "end": 198.137
  },
  {
    "text": "والرسالة؟ وصلت",
    "seg": "s39",
    "start": 199.6,
    "end": 201.1
  },
  {
    "text": "وقرأتها وتوقّفت لحظة…",
    "seg": "s39",
    "start": 201.1,
    "end": 203.3
  },
  {
    "text": "ثم أجبت",
    "seg": "s39",
    "start": 203.3,
    "end": 204.006
  },
  {
    "text": "وبقي المساء لمشروعك",
    "seg": "s40",
    "start": 204.28,
    "end": 205.937
  },
  {
    "text": "الرسالة نفسها",
    "seg": "s41",
    "start": 206.2,
    "end": 207.44
  },
  {
    "text": "والمساء نفسه…",
    "seg": "s41",
    "start": 207.44,
    "end": 208.7
  },
  {
    "text": "والفرق ثانيتان من التوقّف",
    "seg": "s41",
    "start": 208.7,
    "end": 210.913
  },
  {
    "text": "قبل أن تقول «نعم»…",
    "seg": "s42",
    "start": 211.953,
    "end": 213.32
  },
  {
    "text": "تأكّد أنها إجابتك",
    "seg": "s42",
    "start": 213.32,
    "end": 214.873
  },
  {
    "text": "وفي الطلب القادم",
    "seg": "s43",
    "start": 215.103,
    "end": 216.36
  },
  {
    "text": "توقّف راجع وقتك",
    "seg": "s43",
    "start": 216.36,
    "end": 218.22
  },
  {
    "text": "ثم أجب",
    "seg": "s43",
    "start": 218.22,
    "end": 218.98
  }
]
