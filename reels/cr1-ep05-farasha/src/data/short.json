 "captions": [
  {
   "seg": "R1",
   "text": "نفس الحسبة…",
   "start": 0.386,
   "end": 1.531,
   "cps": 9.6
  },
  {
   "seg": "R1",
   "text": "ونفس الجهاز…",
   "start": 1.581,
   "end": 2.883,
   "cps": 9.2
  },
  {
   "seg": "R1",
   "text": "وطلع طقس ثاني تمامًا.",
   "start": 2.933,
   "end": 5.404,
   "cps": 8.5
  },
  {
   "seg": "R2",
   "text": "إدوارد لورنز، عالم أرصاد،",
   "start": 5.454,
   "end": 7.55,
   "cps": 11.9
  },
  {
   "seg": "R2",
   "text": "كان يحاكي الطقس على كمبيوتر.",
   "start": 7.6,
   "end": 9.536,
   "cps": 14.5
  },
  {
   "seg": "R3",
   "text": "أراد يعيد جزءًا من الحسبة،",
   "start": 9.586,
   "end": 11.469,
   "cps": 13.8
  },
  {
   "seg": "R3",
   "text": "فنقل الأرقام من الورقة…",
   "start": 11.519,
   "end": 13.365,
   "cps": 12.5
  },
  {
   "seg": "R3",
   "text": "والورقة تقرّب لثلاث خانات بس.",
   "start": 13.415,
   "end": 16.151,
   "cps": 10.6
  },
  {
   "seg": "R4",
   "text": "ضغط تشغيل…",
   "start": 16.201,
   "end": 17.788,
   "cps": 6.3
  },
  {
   "seg": "R4",
   "text": "وراح يشرب قهوة.",
   "start": 17.838,
   "end": 19.88,
   "cps": 7.3
  },
  {
   "seg": "R5",
   "text": "رجع بعد ساعة.",
   "start": 20.889,
   "end": 22.585,
   "cps": 7.7
  },
  {
   "seg": "R5",
   "text": "الخطّان مشوا سوا…",
   "start": 22.635,
   "end": 24.041,
   "cps": 12.1
  },
  {
   "seg": "R5",
   "text": "وبعدين تفرّقوا،",
   "start": 24.091,
   "end": 25.428,
   "cps": 11.2
  },
  {
   "seg": "R5",
   "text": "لين ما بقي بينهم شبه.",
   "start": 25.478,
   "end": 27.9,
   "cps": 8.7
  },
  {
   "seg": "R6",
   "text": "في نظام مثل الطقس،",
   "start": 27.95,
   "end": 29.342,
   "cps": 12.9
  },
  {
   "seg": "R6",
   "text": "الفرق الصغير يكبر مع الوقت.",
   "start": 29.392,
   "end": 31.513,
   "cps": 12.7
  },
  {
   "seg": "R6",
   "text": "وعشان كذا",
   "start": 31.563,
   "end": 32.36,
   "cps": 11.3
  },
  {
   "seg": "R6",
   "text": "ما نقدر نتوقعه بدقة",
   "start": 32.41,
   "end": 33.96,
   "cps": 12.3
  },
  {
   "seg": "R6",
   "text": "لأبعد من أسبوعين تقريبًا.",
   "start": 34.01,
   "end": 36.19,
   "cps": 11.5
  },
  {
   "seg": "R7",
   "text": "ومنها جا اسم «تأثير الفراشة»:",
   "start": 36.24,
   "end": 39.131,
   "cps": 10.0
  },
  {
   "seg": "R7",
   "text": "هل رفرفة في البرازيل",
   "start": 39.181,
   "end": 40.55,
   "cps": 14.6
  },
  {
   "seg": "R7",
   "text": "تطلق إعصارًا في تكساس؟",
   "start": 40.6,
   "end": 42.405,
   "cps": 12.2
  },
  {
   "seg": "R8",
   "text": "وجواب لورنز:",
   "start": 42.455,
   "end": 43.547,
   "cps": 11.0
  },
  {
   "seg": "R8",
   "text": "الرفرفة اللي تقدر",
   "start": 43.597,
   "end": 44.67,
   "cps": 15.8
  },
  {
   "seg": "R8",
   "text": "تساعد في إعصار،",
   "start": 44.72,
   "end": 45.915,
   "cps": 12.6
  },
  {
   "seg": "R8",
   "text": "تقدر تساعد في منعه.",
   "start": 45.965,
   "end": 47.497,
   "cps": 12.4
  },
  {
   "seg": "R8",
   "text": "يعني: ما نقدر نعرف.",
   "start": 47.547,
   "end": 50.083,
   "cps": 7.5
  },
  {
   "seg": "R9",
   "text": "ثلاث خانات ما ظهرت على ورقة…",
   "start": 50.133,
   "end": 52.472,
   "cps": 12.0
  },
  {
   "seg": "R9",
   "text": "غيّرت فهمنا للتوقّع.",
   "start": 52.522,
   "end": 54.885,
   "cps": 8.5
  },
  {
   "seg": "R10",
   "text": "إيش أصغر تفصيلة غيّرت يومك؟",
   "start": 54.935,
   "end": 58.69,
   "cps": 7.2
  }
 ]
}
