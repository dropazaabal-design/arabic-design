{
 "source": "recording",
 "total": 42.715,
 "frames": 2563,
 "lines": [
  {
   "id": 1,
   "unit": "VO",
   "text": "تعرف لما أحد يسألك عن كتاب ما قريته… وتهز راسك كأنك قريته؟",
   "start": 0.3,
   "end": 4.99
  },
  {
   "id": 2,
   "unit": "VO",
   "text": "هذا تمثيل. بس فيه تمثيل ثاني… يغيّرك.",
   "start": 5.46,
   "end": 9.12
  },
  {
   "id": 3,
   "unit": "VO",
   "text": "فيه فكرة قديمة في علم النفس اسمها: تصرّف كأنّك.",
   "start": 9.59,
   "end": 13.48
  },
  {
   "id": 4,
   "unit": "VO",
   "text": "تبي تصير منضبط؟ لا تنتظر الشعور. تصرّف مثل شخص منضبط… من اليوم.",
   "start": 14.1,
   "end": 19.625
  },
  {
   "id": 5,
   "unit": "VO",
   "text": "أول أيام، بتحس إنك تمثّل.",
   "start": 20.045,
   "end": 22.3
  },
  {
   "id": 6,
   "unit": "VO",
   "text": "بعد أسبوعين… تنسى إنك تمثّل.",
   "start": 22.82,
   "end": 25.29
  },
  {
   "id": 7,
   "unit": "VO",
   "text": "لأنك ما كنت تكذب على الناس… كنت تتدرّب.",
   "start": 25.81,
   "end": 28.86
  },
  {
   "id": 8,
   "unit": "VO",
   "text": "اللي يتصنّع يبي يقنع غيره. واللي يتصرّف كأنّه… يبي يقنع نفسه.",
   "start": 29.38,
   "end": 34.415
  },
  {
   "id": 9,
   "unit": "VO",
   "text": "اختر الشخص اللي تبي تصيره… وامشِ مثله من بكرة.",
   "start": 34.935,
   "end": 38.135
  },
  {
   "id": 10,
   "unit": "VO",
   "text": "وش أول عادة بتمثّلها؟",
   "start": 38.555,
   "end": 40.315
  }
 ]
}
