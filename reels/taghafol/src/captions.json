[
 {
  "start": 0.15,
  "end": 1.43,
  "text": "سُئل أعرابي:",
  "title": false
 },
 {
  "start": 1.43,
  "end": 3.45,
  "text": "من أذكى الناس؟",
  "title": false
 },
 {
  "start": 3.45,
  "end": 5.65,
  "text": "قال: الفطن المتغافل",
  "title": false
 },
 {
  "start": 5.75,
  "end": 6.97,
  "text": "وتغافل…",
  "title": false
 },
 {
  "start": 7.59,
  "end": 8.97,
  "text": "التغافل",
  "title": false
 },
 {
  "start": 9.59,
  "end": 12.21,
  "text": "هو تكلّف الغفلة",
  "title": false
 },
 {
  "start": 12.97,
  "end": 14.97,
  "text": "تغافل، تغابى",
  "title": false
 },
 {
  "start": 15.63,
  "end": 17.43,
  "text": "تكلّف الغباء",
  "title": false
 },
 {
  "start": 17.43,
  "end": 19.65,
  "text": "تكلّف أن تظهر كذلك",
  "title": false
 },
 {
  "start": 19.65,
  "end": 21.41,
  "text": "وأنت لست كذلك",
  "title": false
 },
 {
  "start": 21.7,
  "end": 22.81,
  "text": "وهذا التغافل",
  "title": false
 },
 {
  "start": 25.08,
  "end": 28.54,
  "text": "هو فطِن لما يكون حوله",
  "title": false
 },
 {
  "start": 28.54,
  "end": 30.26,
  "text": "لكن متغافل",
  "title": false
 },
 {
  "start": 30.26,
  "end": 33.48,
  "text": "ليس يحقّق في كل ما يقع",
  "title": false
 },
 {
  "start": 33.48,
  "end": 34.33,
  "text": "أنت لماذا قلت؟",
  "title": false
 },
 {
  "start": 34.33,
  "end": 36.34,
  "text": "أنا رأيتك… ترى أنا شفتك",
  "title": false
 },
 {
  "start": 37.02,
  "end": 38.64,
  "text": "لذا قال الأول",
  "title": false
 },
 {
  "start": 38.94,
  "end": 39.6,
  "text": "قال:",
  "title": false
 },
 {
  "start": 40.68,
  "end": 43.88,
  "text": "ليس الغبيُّ بسيدٍ في قومه",
  "title": true
 },
 {
  "start": 44.1,
  "end": 48.22,
  "text": "لكنّ سيدَ قومِه المتغابي",
  "title": true
 },
 {
  "start": 48.76,
  "end": 50.8,
  "text": "وتغافلْ عن أمورٍ إنه",
  "title": true
 },
 {
  "start": 50.8,
  "end": 52.78,
  "text": "لم يفُزْ بالحمدِ إلا من غفل",
  "title": true
 },
 {
  "start": 52.8,
  "end": 53.78,
  "text": "نعم",
  "title": false
 },
 {
  "start": 53.78,
  "end": 56.86,
  "text": "لم يفز بالحمد… حمد الرجال",
  "title": false
 },
 {
  "start": 56.86,
  "end": 60.7,
  "text": "حمد من عاشره من رجل وامرأة",
  "title": false
 },
 {
  "start": 60.7,
  "end": 63.16,
  "text": "هذه من خصال السادة",
  "title": false
 },
 {
  "start": 63.16,
  "end": 65.5,
  "text": "من خصال الوجهاء",
  "title": false
 },
 {
  "start": 65.5,
  "end": 67.0,
  "text": "هذا التغافل",
  "title": false
 },
 {
  "start": 67.0,
  "end": 69.8,
  "text": "والتغافل مطلوب حتى في بيتك",
  "title": false
 },
 {
  "start": 69.8,
  "end": 73.4,
  "text": "مع بنيك، مع أهلك، مع من إليك",
  "title": false
 },
 {
  "start": 73.48,
  "end": 75.8,
  "text": "التغافل هي: لقد رأيت، لكن",
  "title": false
 },
 {
  "start": 75.8,
  "end": 79.48,
  "text": "اصنع كأنك لم تسمع ولم يُقل",
  "title": false
 }
]
