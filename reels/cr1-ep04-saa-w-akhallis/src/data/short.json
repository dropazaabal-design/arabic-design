 "captions": [
  {
   "seg": "R1",
   "text": "ناصر عنده ضيوف الساعة سبع.",
   "start": 0.325,
   "end": 3.002,
   "cps": 9.7
  },
  {
   "seg": "R1",
   "text": "الساعة أربع فتح كرتون مكتبة جديدة، وقال: ساعة وأخلّصها.",
   "start": 3.052,
   "end": 8.107,
   "cps": 10.9
  },
  {
   "seg": "R2",
   "text": "أول برغي دخل عوج. والتعليمات كلها رسوم.",
   "start": 8.157,
   "end": 12.321,
   "cps": 9.4
  },
  {
   "seg": "R2",
   "text": "والقطعة رقم ثلاثة… طلعت مقلوبة.",
   "start": 12.371,
   "end": 15.757,
   "cps": 9.2
  },
  {
   "seg": "R2",
   "text": "الساعة سبع رنّ الجرس… والمكتبة نصها على الأرض.",
   "start": 15.807,
   "end": 20.587,
   "cps": 9.6
  },
  {
   "seg": "R3",
   "text": "دانيال كانمان، في كتاب «التفكير السريع والبطيء»، يسمّي هذا: مغالطة التخطيط.",
   "start": 20.637,
   "end": 27.202,
   "cps": 11.4
  },
  {
   "seg": "R3",
   "text": "نقدّر الوقت على أحسن احتمال… كأن ولا برغي بيعاند.",
   "start": 27.252,
   "end": 32.174,
   "cps": 10.0
  },
  {
   "seg": "R4",
   "text": "وكانمان نفسه وقع فيها: قدّر هو وفريقه كتابًا مدرسيًا بسنتين.",
   "start": 32.224,
   "end": 37.756,
   "cps": 10.8
  },
  {
   "seg": "R4",
   "text": "مع إن خبيرًا معهم قال: ولا فريق مثلكم خلّص في أقل من سبع سنين.",
   "start": 37.806,
   "end": 43.729,
   "cps": 10.5
  },
  {
   "seg": "R4",
   "text": "وخلّصوه بعد قرابة ثمان.",
   "start": 43.779,
   "end": 46.178,
   "cps": 9.6
  },
  {
   "seg": "R5",
   "text": "فلا تسأل: كم بياخذ معي؟",
   "start": 46.228,
   "end": 48.333,
   "cps": 10.9
  },
  {
   "seg": "R5",
   "text": "اسأل: كم أخذ مع غيري؟ وكم أخذ معي آخر مرة؟",
   "start": 48.383,
   "end": 53.267,
   "cps": 8.6
  },
  {
   "seg": "R6",
   "text": "بعد شهر اشترى ناصر طاولة. وقبل ما يفتحها، فتح جواله:",
   "start": 53.317,
   "end": 58.443,
   "cps": 10.1
  },
  {
   "seg": "R6",
   "text": "المكتبة أخذت خمس ساعات.",
   "start": 58.493,
   "end": 60.968,
   "cps": 9.3
  },
  {
   "seg": "R6",
   "text": "فبدأ من الظهر.",
   "start": 61.018,
   "end": 63.047,
   "cps": 6.9
  },
  {
   "seg": "R6",
   "text": "والساعة سبع رنّ الجرس… والطاولة جاهزة.",
   "start": 63.097,
   "end": 67.086,
   "cps": 9.5
  },
  {
   "seg": "R7",
   "text": "إيش الشغلة اللي دايم تقول عنها: ساعة وأخلّصها؟",
   "start": 67.136,
   "end": 71.487,
   "cps": 10.6
  }
 ]
}
