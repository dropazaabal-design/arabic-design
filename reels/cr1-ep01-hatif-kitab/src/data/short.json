  {
   "seg": "R1",
   "text": "كل ليلة تقول: اليوم أقرأ.",
   "start": 0.388,
   "end": 3.474,
   "cps": 8.1
  },
  {
   "seg": "R2",
   "text": "لكن الكتاب داخل الدرج، والهاتف قدامك.",
   "start": 3.524,
   "end": 6.935,
   "cps": 10.8
  },
  {
   "seg": "R2",
   "text": "يضيء مرة، ومرة ثانية…",
   "start": 6.985,
   "end": 9.715,
   "cps": 7.7
  },
  {
   "seg": "R2",
   "text": "وتخلص الليلة، والدرج ما انفتح.",
   "start": 9.765,
   "end": 12.549,
   "cps": 10.8
  },
  {
   "seg": "R2",
   "text": "قبل ما تلوم نفسك،",
   "start": 12.599,
   "end": 13.934,
   "cps": 12.7
  },
  {
   "seg": "R2",
   "text": "شوف أي خيار أنت مجهّزه لنفسك.",
   "start": 13.984,
   "end": 16.657,
   "cps": 10.8
  },
  {
   "seg": "R3",
   "text": "في كتاب «العادات الذرية»، يشرح جيمس كلير",
   "start": 16.707,
   "end": 19.82,
   "cps": 12.8
  },
  {
   "seg": "R3",
   "text": "أن البيئة كثيرًا ما تؤثر في سلوكنا أكثر من الحماس.",
   "start": 19.87,
   "end": 23.785,
   "cps": 12.8
  },
  {
   "seg": "R3",
   "text": "وكل عادة تبدأ بإشارة،",
   "start": 23.835,
   "end": 25.692,
   "cps": 11.3
  },
  {
   "seg": "R3",
   "text": "والإشارة الظاهرة أسهل أن ننتبه لها.",
   "start": 25.742,
   "end": 29.108,
   "cps": 10.4
  },
  {
   "seg": "R4",
   "text": "خلّينا نغيّر شيئًا واحدًا:",
   "start": 29.158,
   "end": 31.148,
   "cps": 13.1
  },
  {
   "seg": "R4",
   "text": "الكتاب يطلع من الدرج، ويستقر مفتوحًا على المكتب.",
   "start": 31.198,
   "end": 35.138,
   "cps": 12.2
  },
  {
   "seg": "R4",
   "text": "والهاتف يروح للشاحن، بعيدًا عنك.",
   "start": 35.188,
   "end": 38.216,
   "cps": 10.6
  },
  {
   "seg": "R4",
   "text": "الآن أول شيء تشوفه هو الصفحة،",
   "start": 38.266,
   "end": 40.897,
   "cps": 11.0
  },
  {
   "seg": "R4",
   "text": "والهاتف يحتاج منك تقوم له.",
   "start": 40.947,
   "end": 43.242,
   "cps": 11.3
  },
  {
   "seg": "R4",
   "text": "هذا مثال من عندنا، لكنه يوضّح الفكرة.",
   "start": 43.292,
   "end": 46.355,
   "cps": 12.1
  },
  {
   "seg": "R5",
   "text": "جرّبها أسبوعًا: اختر مكانًا ظاهرًا للكتاب،",
   "start": 46.405,
   "end": 49.784,
   "cps": 12.4
  },
  {
   "seg": "R5",
   "text": "وراقب: هل صار البدء أسهل؟",
   "start": 49.834,
   "end": 52.173,
   "cps": 10.7
  },
  {
   "seg": "R5",
   "text": "علّم كل ليلة فتحت فيها الكتاب.",
   "start": 52.223,
   "end": 54.954,
   "cps": 11.0
  },
  {
   "seg": "R5",
   "text": "الظهور ما يقرأ عنك، ولا يحلّ كل العوائق.",
   "start": 55.004,
   "end": 58.165,
   "cps": 12.7
  },
  {
   "seg": "R5",
   "text": "لكنه يسهّل أول خطوة.",
   "start": 58.215,
   "end": 60.387,
   "cps": 9.2
  },
  {
   "seg": "R6",
   "text": "نفس المكتب، ونفس النيّة. تغيّر المكان فقط.",
   "start": 60.437,
   "end": 64.244,
   "cps": 11.0
  },
  {
   "seg": "R6",
   "text": "وأنت، أول شيء تشوفه في غرفتك…",
   "start": 64.294,
   "end": 66.908,
   "cps": 11.1
  },
  {
   "seg": "R6",
   "text": "إلى أي خيار يدعوك؟",
   "start": 66.958,
   "end": 69.718,
   "cps": 6.5
  }
 ]
}
