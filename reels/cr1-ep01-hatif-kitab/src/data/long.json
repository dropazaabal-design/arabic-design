   "start": 227.989,
   "end": 228.829
  }
 ],
 "captions": [
  {
   "seg": "L1",
   "text": "كل ليلة تقول: اليوم أقرأ.",
   "start": 1.239,
   "end": 4.167,
   "cps": 8.5
  },
  {
   "seg": "L1",
   "text": "لكن الكتاب داخل الدرج، والهاتف قدامك.",
   "start": 4.217,
   "end": 7.748,
   "cps": 10.5
  },
  {
   "seg": "L1",
   "text": "قبل ما تلوم نفسك،",
   "start": 7.798,
   "end": 9.094,
   "cps": 13.1
  },
  {
   "seg": "L1",
   "text": "شوف أي خيار أنت مجهّزه لنفسك.",
   "start": 9.144,
   "end": 12.3,
   "cps": 9.2
  },
  {
   "seg": "L2",
   "text": "الساعة عشرة بالليل. تجلس على المكتب، ونيّتك صادقة.",
   "start": 12.786,
   "end": 17.581,
   "cps": 10.4
  },
  {
   "seg": "L2",
   "text": "الكتاب اللي اشتريته من شهر محفوظ في الدرج.",
   "start": 17.631,
   "end": 20.474,
   "cps": 14.8
  },
  {
   "seg": "L2",
   "text": "والهاتف على المكتب، وشاشته للأعلى.",
   "start": 20.524,
   "end": 23.548,
   "cps": 11.2
  },
  {
   "seg": "L2",
   "text": "يضيء مرة، فتشوف إشعارًا.",
   "start": 23.598,
   "end": 25.826,
   "cps": 10.8
  },
  {
   "seg": "L2",
   "text": "يضيء مرة ثانية، وتقول: دقيقة واحدة بس.",
   "start": 25.876,
   "end": 29.481,
   "cps": 10.5
  },
  {
   "seg": "L2",
   "text": "فتقرر تستعمل قوة الإرادة:",
   "start": 29.531,
   "end": 31.939,
   "cps": 10.4
  },
  {
   "seg": "L2",
   "text": "تقلب الهاتف على وجهه.",
   "start": 31.989,
   "end": 33.838,
   "cps": 11.4
  },
  {
   "seg": "L2",
   "text": "لكنه يهتز، وترجع تقلبه.",
   "start": 33.888,
   "end": 36.453,
   "cps": 9.0
  },
  {
   "seg": "L2",
   "text": "وبعد ساعة، الدرج ما انفتح.",
   "start": 36.503,
   "end": 39.609,
   "cps": 8.4
  },
  {
   "seg": "L3",
   "text": "في كتاب «العادات الذرية»، يقدّم جيمس كلير تفسيرًا مختلفًا:",
   "start": 40.1,
   "end": 45.085,
   "cps": 11.6
  },
  {
   "seg": "L3",
   "text": "البيئة كثيرًا ما تؤثر في سلوكنا أكثر من الحماس.",
   "start": 45.135,
   "end": 49.238,
   "cps": 11.5
  },
  {
   "seg": "L3",
   "text": "واللي يبدو أنهم ملتزمون بسهولة،",
   "start": 49.288,
   "end": 51.738,
   "cps": 12.7
  },
  {
   "seg": "L3",
   "text": "كثير منهم يعيشون في بيئة تسهّل عليهم الالتزام.",
   "start": 51.788,
   "end": 55.833,
   "cps": 11.4
  },
  {
   "seg": "L3",
   "text": "وكل عادة تبدأ بإشارة،",
   "start": 55.883,
   "end": 58.239,
   "cps": 8.9
  },
  {
   "seg": "L3",
   "text": "والإشارة الظاهرة أسهل أن ننتبه لها.",
   "start": 58.289,
   "end": 61.971,
   "cps": 9.5
  },
  {
   "seg": "L4",
   "text": "خلّينا نرسمها.",
   "start": 62.231,
   "end": 63.562,
   "cps": 10.5
  },
  {
   "seg": "L4",
   "text": "أول الطريق إشارة: شيء تشوفه، مثل ضوء الشاشة.",
   "start": 63.612,
   "end": 68.227,
   "cps": 9.5
  },
  {
   "seg": "L4",
   "text": "بعدها رغبة: ربما وصلت رسالة مهمة؟",
   "start": 68.277,
   "end": 72.199,
   "cps": 8.4
  },
  {
   "seg": "L4",
   "text": "وبعدها فعل: تمد يدك وتفتح الهاتف.",
   "start": 72.249,
   "end": 76.172,
   "cps": 8.4
  },
  {
   "seg": "L4",
   "text": "الإشارة ما تجبرك على شيء، لكنها تفتح الباب.",
   "start": 76.222,
   "end": 80.243,
   "cps": 10.7
  },
  {
   "seg": "L4",
   "text": "والهاتف عنده ميزة ما عند الكتاب:",
   "start": 80.293,
   "end": 83.099,
   "cps": 11.4
  },
  {
   "seg": "L4",
   "text": "إشارته ظاهرة طول الوقت، وهو قريب منك.",
   "start": 83.149,
   "end": 86.698,
   "cps": 10.4
  },
  {
   "seg": "L4",
   "text": "أما الكتاب، فإشارته مقفول عليها في الدرج.",
   "start": 86.748,
   "end": 90.199,
   "cps": 11.9
  },
  {
   "seg": "L4",
   "text": "يعني المنافسة من البداية غير عادلة:",
   "start": 90.249,
   "end": 93.305,
   "cps": 11.5
  },
  {
   "seg": "L4",
   "text": "واحد يناديك كل دقيقة،",
   "start": 93.355,
   "end": 95.308,
   "cps": 10.8
  },
  {
   "seg": "L4",
   "text": "والثاني ينتظر أنك تتذكره.",
   "start": 95.358,
   "end": 98.611,
   "cps": 7.7
  },
  {
   "seg": "L5",
   "text": "طيب، خلّينا نغيّر شيئًا واحدًا بس.",
   "start": 99.204,
   "end": 102.193,
   "cps": 11.4
  },
  {
   "seg": "L5",
   "text": "ما نغيّر نيّتك، ولا نزيد حماسك. نغيّر المكان.",
   "start": 102.243,
   "end": 106.431,
   "cps": 10.7
  },
  {
   "seg": "L5",
   "text": "الكتاب يطلع من الدرج، ويستقر مفتوحًا على المكتب،",
   "start": 106.481,
   "end": 110.011,
   "cps": 13.6
  },
  {
   "seg": "L5",
   "text": "على الصفحة اللي وقفت عندها.",
   "start": 110.061,
   "end": 111.84,
   "cps": 15.2
  },
  {
   "seg": "L5",
   "text": "والهاتف يروح للشاحن في الغرفة الثانية.",
   "start": 111.89,
   "end": 114.766,
   "cps": 13.2
  },
  {
   "seg": "L5",
   "text": "الآن لما تجلس، أول شيء تشوفه هو الصفحة.",
   "start": 114.816,
   "end": 118.354,
   "cps": 11.0
  },
  {
   "seg": "L5",
   "text": "ما احتجت تتذكر الكتاب، هو اللي ذكّرك.",
   "start": 118.404,
   "end": 121.279,
   "cps": 12.9
  },
  {
   "seg": "L5",
   "text": "والهاتف صار يحتاج منك تقوم وتمشي له.",
   "start": 121.329,
   "end": 124.433,
   "cps": 11.6
  },
  {
   "seg": "L5",
   "text": "خطوة صغيرة، لكنها تعطيك لحظة تختار فيها.",
   "start": 124.483,
   "end": 127.963,
   "cps": 11.5
  },
  {
   "seg": "L5",
   "text": "هذا مثال توضيحي من عندنا، وليس تجربة علمية.",
   "start": 128.013,
   "end": 131.237,
   "cps": 13.3
  },
  {
   "seg": "L5",
   "text": "لكنه يوضّح الفكرة:",
   "start": 131.287,
   "end": 132.992,
   "cps": 10.6
  },
  {
   "seg": "L5",
   "text": "لما تتغير الإشارة، يتغير أسهل خيار.",
   "start": 133.042,
   "end": 136.982,
   "cps": 8.9
  },
  {
   "seg": "L6",
   "text": "لكن خلّينا ما نبالغ.",
   "start": 137.553,
   "end": 139.381,
   "cps": 10.9
  },
  {
   "seg": "L6",
   "text": "ظهور الكتاب ما يزيل كل عوائق القراءة.",
   "start": 139.431,
   "end": 142.719,
   "cps": 11.3
  },
  {
   "seg": "L6",
   "text": "إذا كان الكتاب ثقيلًا عليك، أو كنت مرهقًا،",
   "start": 142.769,
   "end": 146.079,
   "cps": 12.7
  },
  {
   "seg": "L6",
   "text": "أو ما عندك وقت فعلًا، الإشارة وحدها ما تكفي.",
   "start": 146.129,
   "end": 150.159,
   "cps": 10.9
  },
  {
   "seg": "L6",
   "text": "وشيء آخر:",
   "start": 150.209,
   "end": 151.134,
   "cps": 9.7
  },
  {
   "seg": "L6",
   "text": "اللي يبقى قدامك فترة طويلة،",
   "start": 151.184,
   "end": 153.119,
   "cps": 14.0
  },
  {
   "seg": "L6",
   "text": "ممكن تتعوّد عليه لدرجة أنك ما تلاحظه.",
   "start": 153.169,
   "end": 156.037,
   "cps": 12.9
  },
  {
   "seg": "L6",
   "text": "فالفكرة ما تقول: حط الكتاب وخلاص.",
   "start": 156.087,
   "end": 158.733,
   "cps": 12.5
  },
  {
   "seg": "L6",
   "text": "الفكرة تقول: سهّل أول خطوة.",
   "start": 158.783,
   "end": 161.352,
   "cps": 10.5
  },
  {
   "seg": "L6",
   "text": "والباقي يحتاج كتابًا يناسبك، ووقتًا حقيقيًا.",
   "start": 161.402,
   "end": 166.069,
   "cps": 9.4
  },
  {
   "seg": "L7",
   "text": "نجرّبها أسبوعًا، بثلاث خطوات.",
   "start": 166.561,
   "end": 169.661,
   "cps": 9.4
  },
  {
   "seg": "L7",
   "text": "أولًا: اختر مكانًا تمرّ عليه كل ليلة،",
   "start": 169.711,
   "end": 173.264,
   "cps": 10.4
  },
  {
   "seg": "L7",
   "text": "مثل المكتب أو جنب السرير.",
   "start": 173.314,
   "end": 175.593,
   "cps": 11.0
  },
  {
   "seg": "L7",
   "text": "ثانيًا: حط الكتاب هناك، مفتوحًا على صفحتك.",
   "start": 175.643,
   "end": 179.905,
   "cps": 9.9
  },
  {
   "seg": "L7",
   "text": "ثالثًا: أبعد الشاحن عن هذا المكان، ولو مترين.",
   "start": 179.955,
   "end": 184.106,
   "cps": 10.8
  },
  {
   "seg": "L7",
   "text": "وكل ليلة، اسأل نفسك سؤالًا واحدًا:",
   "start": 184.156,
   "end": 187.333,
   "cps": 10.7
  },
  {
   "seg": "L7",
   "text": "هل كان البدء أسهل؟",
   "start": 187.383,
   "end": 189.177,
   "cps": 10.0
  },
  {
   "seg": "L7",
   "text": "ما نقيس عدد الصفحات.",
   "start": 189.227,
   "end": 191.158,
   "cps": 10.4
  },
  {
   "seg": "L7",
   "text": "نقيس شيئًا أبسط: كم ليلة فتحت الكتاب.",
   "start": 191.208,
   "end": 194.943,
   "cps": 9.9
  },
  {
   "seg": "L7",
   "text": "علامة صغيرة على ورقة جنب الكتاب تكفي.",
   "start": 194.993,
   "end": 198.648,
   "cps": 10.1
  },
  {
   "seg": "L7",
   "text": "وإذا ما تغيّر شيء بعد أسبوع،",
   "start": 198.698,
   "end": 201.006,
   "cps": 12.1
  },
  {
   "seg": "L7",
   "text": "هذه معلومة مفيدة أيضًا:",
   "start": 201.056,
   "end": 203.184,
   "cps": 10.8
  },
  {
   "seg": "L7",
   "text": "يمكن العائق في مكان آخر، مثل نوع الكتاب أو وقت القراءة.",
   "start": 203.234,
   "end": 208.584,
   "cps": 10.3
  },
  {
   "seg": "L8",
   "text": "نرجع للمكتب نفسه. نفس النيّة، ونفس الليلة.",
   "start": 209.188,
   "end": 212.989,
   "cps": 11.0
  },
  {
   "seg": "L8",
   "text": "لكن هذه المرة، الكتاب قدامك، والهاتف بعيد.",
   "start": 213.039,
   "end": 216.983,
   "cps": 10.6
  },
  {
   "seg": "L8",
   "text": "ما صرت شخصًا آخر، وما احتجت حماسًا أكبر.",
   "start": 217.033,
   "end": 220.379,
   "cps": 12.0
  },
  {
   "seg": "L8",
   "text": "بس رتّبت المكان لصالح الخيار اللي تريده.",
   "start": 220.429,
   "end": 223.472,
   "cps": 13.1
  },
  {
   "seg": "L8",
   "text": "فسؤالي لك:",
   "start": 223.522,
   "end": 224.579,
   "cps": 9.5
  },
  {
   "seg": "L8",
   "text": "أول شيء تشوفه لما تدخل غرفتك…",
   "start": 224.629,
   "end": 226.979,
   "cps": 12.3
  },
  {
   "seg": "L8",
   "text": "إلى أي خيار يدعوك؟",
   "start": 227.029,
   "end": 230.029,
   "cps": 6.0
  }
 ]
}
